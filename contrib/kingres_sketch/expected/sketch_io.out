--
-- sketch_io: text and bytea input and output of the three types, and what
-- happens to values that are cut off, too long or corrupted.
SET search_path = public, kingres_sketch;
-- helpers that write the bytes of a value: little-endian integers and doubles
CREATE FUNCTION pg_temp.le(i bigint, n int) RETURNS text LANGUAGE sql IMMUTABLE AS
$$ SELECT string_agg(lpad(to_hex(((i >> (8 * b)) & 255)::int), 2, '0'), '' ORDER BY b)
     FROM generate_series(0, n - 1) b $$;
CREATE FUNCTION pg_temp.lef(x float8) RETURNS text LANGUAGE sql IMMUTABLE AS
$$ SELECT string_agg(substr(encode(float8send(x), 'hex'), 2 * i + 1, 2), '' ORDER BY 7 - i)
     FROM generate_series(0, 7) i $$;
-- a top-n value: capacity, total, counters (item length, count, error, item in hex)
CREATE FUNCTION pg_temp.tn(k bigint, total bigint, n bigint, entries text) RETURNS text LANGUAGE sql IMMUTABLE AS
$$ SELECT '\x4b010200' || pg_temp.le(k, 4) || pg_temp.le(total, 8) || pg_temp.le(n, 4) || entries $$;
CREATE FUNCTION pg_temp.tne(len bigint, count bigint, err bigint, itemhex text) RETURNS text LANGUAGE sql IMMUTABLE AS
$$ SELECT pg_temp.le(len, 2) || pg_temp.le(count, 8) || pg_temp.le(err, 8) || itemhex $$;
-- a t-digest value: compression, centroid count, total, min, max, centroids
CREATE FUNCTION pg_temp.td(c bigint, n bigint, total bigint, mn float8, mx float8, cents text) RETURNS text LANGUAGE sql IMMUTABLE AS
$$ SELECT '\x4b010300' || pg_temp.le(c, 4) || pg_temp.le(n, 4) || pg_temp.le(total, 8)
          || pg_temp.lef(mn) || pg_temp.lef(mx) || cents $$;
CREATE FUNCTION pg_temp.tdc(mean float8, w bigint) RETURNS text LANGUAGE sql IMMUTABLE AS
$$ SELECT pg_temp.lef(mean) || pg_temp.le(w, 8) $$;
-- text input of hll
SELECT name, (e).sql_error_code AS code, (e).message, (e).detail
  FROM (SELECT name, pg_input_error_info(v, 'kingres_sketch.hll') AS e
          FROM (VALUES
            ('not hex', 'abc'),
            ('no prefix', '4b010104'),
            ('odd digits', '\x4b01010'),
            ('bad digit', '\x4b0101zz'),
            ('empty', '\x'),
            ('short', '\x4b0101'),
            ('bad magic', '\x4c010104'),
            ('format 2', '\x4b020104'),
            ('format 0', '\x4b000104'),
            ('kind topn', '\x4b010204'),
            ('precision 3', '\x4b010103'),
            ('precision 19', '\x4b010113'),
            ('sparse, not sorted', '\x4b0101044100000001000000'),
            ('sparse, same register', '\x4b0101040100000002000000'),
            ('sparse, rank 0', '\x4b01010400000000'),
            ('sparse, rank 62', '\x4b0101043e000000'),
            ('sparse, register 16', '\x4b01010401040000'),
            ('sparse, 5 bytes', '\x4b0101040100000000'),
            ('dense, all zero', '\x4b010104000000000000000000000000'),
            ('dense, 11 bytes', '\x4b0101044110000000000000000000'),
            ('dense, rank 62', '\x4b0101043e1000000000000000000000'),
            ('too long', '\x' || repeat('00', 200000))
          ) t(name, v)) s
 ORDER BY name;
         name          | code  |              message              |                            detail                             
-----------------------+-------+-----------------------------------+---------------------------------------------------------------
 bad digit             | 22P02 | invalid input syntax for type hll | A character that is not a hexadecimal digit was found.
 bad magic             | 22P02 | invalid input syntax for type hll | bad magic byte 0x4c.
 dense, 11 bytes       | 22P02 | invalid input syntax for type hll | length of 15 bytes does not fit precision 4.
 dense, all zero       | 22P02 | invalid input syntax for type hll | dense form with only 0 non-zero registers; it must be sparse.
 dense, rank 62        | 22P02 | invalid input syntax for type hll | register 0 holds 62, more than the largest rank 61.
 empty                 | 22P02 | invalid input syntax for type hll | value is too short (0 bytes).
 format 0              | 22P02 | invalid input syntax for type hll | unsupported sketch format 0.
 format 2              | 22P02 | invalid input syntax for type hll | unsupported sketch format 2.
 kind topn             | 22P02 | invalid input syntax for type hll | wrong kind of sketch 2, expected 1.
 no prefix             | 22P02 | invalid input syntax for type hll | The value must start with "\x" and hold hexadecimal digits.
 not hex               | 22P02 | invalid input syntax for type hll | The value must start with "\x" and hold hexadecimal digits.
 odd digits            | 22P02 | invalid input syntax for type hll | The number of hexadecimal digits is odd.
 precision 19          | 22P02 | invalid input syntax for type hll | precision 19 is outside 4 to 18.
 precision 3           | 22P02 | invalid input syntax for type hll | precision 3 is outside 4 to 18.
 short                 | 22P02 | invalid input syntax for type hll | value is too short (3 bytes).
 sparse, 5 bytes       | 22P02 | invalid input syntax for type hll | length of 9 bytes does not fit precision 4.
 sparse, not sorted    | 22P02 | invalid input syntax for type hll | sparse entry 1 is not in increasing register order.
 sparse, rank 0        | 22P02 | invalid input syntax for type hll | sparse entry 0 (register 0, rank 0) is out of range.
 sparse, rank 62       | 22P02 | invalid input syntax for type hll | sparse entry 0 (register 0, rank 62) is out of range.
 sparse, register 16   | 22P02 | invalid input syntax for type hll | sparse entry 0 (register 16, rank 1) is out of range.
 sparse, same register | 22P02 | invalid input syntax for type hll | sparse entry 1 is not in increasing register order.
 too long              | 22P02 | invalid input syntax for type hll | The value is longer than any valid hll.
(22 rows)

SELECT v, pg_input_is_valid(v, 'kingres_sketch.hll') AS valid
  FROM (VALUES ('\x4b010104'), ('\X4B010104'), ('\x4b01010401000000'), ('\x4b010104411000000000000000000000')) t(v);
                 v                  | valid 
------------------------------------+-------
 \x4b010104                         | t
 \X4B010104                         | f
 \x4b01010401000000                 | t
 \x4b010104411000000000000000000000 | t
(4 rows)

