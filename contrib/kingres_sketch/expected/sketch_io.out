SELECT '\x4B01010E'::hll, '\x4b01010401000000'::hll::bytea, ('\x4b010104411000000000000000000000'::hll)::text;
    hll     |       bytea        |                text                
------------+--------------------+------------------------------------
 \x4b01010e | \x4b01010401000000 | \x4b010104411000000000000000000000
(1 row)

SELECT hll_cardinality('\x4b010104411000000000000000000000'), hll_precision('\x4b010104411000000000000000000000');
 hll_cardinality | hll_precision 
-----------------+---------------
               3 |             4
(1 row)

-- bytea casts: validating, SQLSTATE 22023
CREATE FUNCTION pg_temp.try(b bytea, t text) RETURNS text LANGUAGE plpgsql AS
$$ BEGIN
     EXECUTE format('SELECT %L::bytea::%s', b, t);
     RETURN 'valid';
   EXCEPTION WHEN OTHERS THEN
     RETURN SQLSTATE || ': ' || SQLERRM;
   END $$;
SELECT pg_temp.try('\x4b010104', 'kingres_sketch.hll'), pg_temp.try('\x4b0101', 'kingres_sketch.hll'),
       pg_temp.try('\x4c010104', 'kingres_sketch.hll'), pg_temp.try('\x4b020104', 'kingres_sketch.hll'),
       pg_temp.try('\x4b010104ff', 'kingres_sketch.hll'), pg_temp.try('\x', 'kingres_sketch.topn');
  try  |           try            |           try            |           try            |           try            |            try            
-------+--------------------------+--------------------------+--------------------------+--------------------------+---------------------------
 valid | 22023: invalid hll value | 22023: invalid hll value | 22023: invalid hll value | 22023: invalid hll value | 22023: invalid topn value
(1 row)

SELECT pg_temp.try(decode(repeat('00', 200000), 'hex'), 'kingres_sketch.hll');
           try            
--------------------------
 22023: invalid hll value
(1 row)

-- text input of topn: one valid value and its variations
SELECT pg_temp.tn(3, 1, 1, pg_temp.tne(1, 1, 0, '61'))::topn::bytea AS valid_one_item,
       (SELECT item FROM topn_list(pg_temp.tn(3, 1, 1, pg_temp.tne(1, 1, 0, '61'))::topn)) AS item;
                                  valid_one_item                                  | item 
----------------------------------------------------------------------------------+------
 \x4b0102000300000001000000000000000100000001000100000000000000000000000000000061 | a
(1 row)

SELECT name, (e).sql_error_code AS code, (e).message, (e).detail
  FROM (SELECT name, pg_input_error_info(v, 'kingres_sketch.topn') AS e
          FROM (VALUES
            ('too short', '\x4b0102'),
            ('header only', '\x4b010200'),
            ('format 2', '\x4b020200' || pg_temp.le(3, 4) || pg_temp.le(0, 8) || pg_temp.le(0, 4)),
            ('reserved byte', '\x4b010201' || pg_temp.le(3, 4) || pg_temp.le(0, 8) || pg_temp.le(0, 4)),
            ('capacity 0', pg_temp.tn(0, 0, 0, '')),
            ('capacity 100001', pg_temp.tn(100001, 0, 0, '')),
            ('negative total', pg_temp.tn(3, -1, 0, '')),
            ('count above capacity', pg_temp.tn(1, 2, 2, pg_temp.tne(1, 1, 0, '61') || pg_temp.tne(1, 1, 0, '62'))),
            ('count 2^32 with no bytes', pg_temp.tn(3, 1, 4294967295, '')),
            ('counter cut off', pg_temp.tn(3, 1, 1, '0100')),
            ('item length cut off', pg_temp.tn(3, 1, 1, pg_temp.tne(5, 1, 0, '61'))),
            ('item length 1025', pg_temp.tn(3, 1, 1, pg_temp.tne(1025, 1, 0, repeat('61', 1025)))),
            ('count 0', pg_temp.tn(3, 1, 1, pg_temp.tne(1, 0, 0, '61'))),
            ('negative count', pg_temp.tn(3, 1, 1, pg_temp.tne(1, -1, 0, '61'))),
            ('error equal to count', pg_temp.tn(3, 2, 1, pg_temp.tne(1, 1, 1, '61'))),
            ('negative error', pg_temp.tn(3, 2, 1, pg_temp.tne(1, 1, -1, '61'))),
            ('count above total', pg_temp.tn(3, 1, 1, pg_temp.tne(1, 2, 0, '61'))),
            ('counts above total', pg_temp.tn(3, 2, 2, pg_temp.tne(1, 2, 0, '61') || pg_temp.tne(1, 1, 0, '62'))),
            ('error above total / capacity', pg_temp.tn(3, 5, 1, pg_temp.tne(1, 5, 2, '61'))),
            ('item with a zero byte', pg_temp.tn(3, 1, 1, pg_temp.tne(1, 1, 0, '00'))),
            ('same item twice', pg_temp.tn(3, 2, 2, pg_temp.tne(1, 1, 0, '61') || pg_temp.tne(1, 1, 0, '61'))),
            ('counts ascending', pg_temp.tn(3, 3, 2, pg_temp.tne(1, 1, 0, '61') || pg_temp.tne(1, 2, 0, '62'))),
            ('equal counts, items descending', pg_temp.tn(3, 2, 2, pg_temp.tne(1, 1, 0, '62') || pg_temp.tne(1, 1, 0, '61'))),
            ('trailing byte', pg_temp.tn(3, 1, 1, pg_temp.tne(1, 1, 0, '61') || '00'))
          ) t(name, v)) s
 ORDER BY name;
              name              | code  |              message               |                              detail                               
--------------------------------+-------+------------------------------------+-------------------------------------------------------------------
 capacity 0                     | 22P02 | invalid input syntax for type topn | capacity 0 is outside 1 to 100000.
 capacity 100001                | 22P02 | invalid input syntax for type topn | capacity 100001 is outside 1 to 100000.
 count 0                        | 22P02 | invalid input syntax for type topn | count 0 or error 0 of counter 0 is not valid.
 count 2^32 with no bytes       | 22P02 | invalid input syntax for type topn | counter count 4294967295 does not fit the capacity or the length.
 count above capacity           | 22P02 | invalid input syntax for type topn | counter count 2 does not fit the capacity or the length.
 count above total              | 22P02 | invalid input syntax for type topn | count 2 or error 0 of counter 0 is not valid.
 counter cut off                | 22P02 | invalid input syntax for type topn | counter count 1 does not fit the capacity or the length.
 counts above total             | 22P02 | invalid input syntax for type topn | the counts add up to more than the total.
 counts ascending               | 22P02 | invalid input syntax for type topn | counter 1 is not in the canonical order.
 equal counts, items descending | 22P02 | invalid input syntax for type topn | counter 1 is not in the canonical order.
 error above total / capacity   | 22P02 | invalid input syntax for type topn | error of counter 0 exceeds total / capacity.
 error equal to count           | 22P02 | invalid input syntax for type topn | count 1 or error 1 of counter 0 is not valid.
 format 2                       | 22P02 | invalid input syntax for type topn | unsupported sketch format 2.
 header only                    | 22P02 | invalid input syntax for type topn | value is too short (4 bytes).
 item length 1025               | 22P02 | invalid input syntax for type topn | item length 1025 of counter 0 is not valid.
 item length cut off            | 22P02 | invalid input syntax for type topn | item length 5 of counter 0 is not valid.
 item with a zero byte          | 22P02 | invalid input syntax for type topn | item of counter 0 is not valid in the database encoding.
 negative count                 | 22P02 | invalid input syntax for type topn | count -1 or error 0 of counter 0 is not valid.
 negative error                 | 22P02 | invalid input syntax for type topn | count 1 or error -1 of counter 0 is not valid.
 negative total                 | 22P02 | invalid input syntax for type topn | negative total count.
 reserved byte                  | 22P02 | invalid input syntax for type topn | reserved header byte is not zero.
 same item twice                | 22P02 | invalid input syntax for type topn | counter 1 is not in the canonical order.
 too short                      | 22P02 | invalid input syntax for type topn | value is too short (3 bytes).
 trailing byte                  | 22P02 | invalid input syntax for type topn | bytes follow the last counter.
(24 rows)

SELECT name, pg_input_is_valid(v, 'kingres_sketch.topn') AS valid
  FROM (VALUES
    ('empty', pg_temp.tn(3, 0, 0, '')),
    ('two items', pg_temp.tn(3, 3, 2, pg_temp.tne(1, 2, 0, '62') || pg_temp.tne(1, 1, 0, '61'))),
    ('empty item', pg_temp.tn(3, 1, 1, pg_temp.tne(0, 1, 0, ''))),
    ('longest item', pg_temp.tn(3, 1, 1, pg_temp.tne(1024, 1, 0, repeat('61', 1024)))),
    ('error = total / capacity', pg_temp.tn(2, 5, 1, pg_temp.tne(1, 5, 2, '61')))
  ) t(name, v) ORDER BY name;
           name           | valid 
--------------------------+-------
 empty                    | t
 empty item               | t
 error = total / capacity | t
 longest item             | t
 two items                | t
(5 rows)

