--
-- columnar_setup: install the extension; the access method, the settings and
-- their defaults.
CREATE EXTENSION kingres_columnar;
SET search_path = public;
SELECT e.extname, e.extversion, n.nspname, e.extrelocatable
  FROM pg_extension e JOIN pg_namespace n ON n.oid = e.extnamespace
 WHERE e.extname = 'kingres_columnar';
     extname      | extversion | nspname | extrelocatable 
------------------+------------+---------+----------------
 kingres_columnar | 0.1        | kingres | f
(1 row)

-- the access method
SELECT a.amname, a.amtype, p.pronamespace::regnamespace AS handler_schema, p.proname AS handler
  FROM pg_am a JOIN pg_proc p ON p.oid = a.amhandler WHERE a.amname = 'columnar';
  amname  | amtype | handler_schema |     handler      
----------+--------+----------------+------------------
 columnar | t      | kingres        | columnar_handler
(1 row)

-- the library is preloaded by the test server
SHOW shared_preload_libraries;
 shared_preload_libraries 
--------------------------
 kingres_columnar
(1 row)

-- the settings of the extension and their defaults
SELECT name, setting, unit, vartype, enumvals, context, boot_val,
       CASE WHEN name NOT LIKE '%memory' THEN min_val END AS min_val,
       CASE WHEN name NOT LIKE '%memory' THEN max_val END AS max_val
  FROM pg_settings WHERE name LIKE 'kingres\_columnar.%' ORDER BY name;
                  name                  | setting  | unit | vartype |         enumvals          |  context  | boot_val | min_val | max_val  
----------------------------------------+----------+------+---------+---------------------------+-----------+----------+---------+----------
 kingres_columnar.chunk_row_count       | 10000    |      | integer |                           | user      | 10000    | 100     | 100000
 kingres_columnar.compression           | auto     |      | enum    | {auto,none,pglz,lz4,zstd} | user      | auto     |         | 
 kingres_columnar.compression_level     | 3        |      | integer |                           | user      | 3        | 1       | 19
 kingres_columnar.enable_chunk_skipping | on       |      | bool    |                           | user      | on       |         | 
 kingres_columnar.enable_custom_scan    | on       |      | bool    |                           | user      | on       |         | 
 kingres_columnar.max_stripe_rows       | 10000000 |      | integer |                           | superuser | 10000000 | 1000    | 10000000
 kingres_columnar.stripe_row_count      | 150000   |      | integer |                           | user      | 150000   | 1000    | 10000000
 kingres_columnar.write_buffer_memory   | 131072   | kB   | integer |                           | user      | 131072   |         | 
(8 rows)

SHOW kingres_columnar.compression;
 kingres_columnar.compression 
------------------------------
 auto
(1 row)

SHOW kingres_columnar.compression_level;
 kingres_columnar.compression_level 
------------------------------------
 3
(1 row)

SHOW kingres_columnar.stripe_row_count;
 kingres_columnar.stripe_row_count 
-----------------------------------
 150000
(1 row)

SHOW kingres_columnar.chunk_row_count;
 kingres_columnar.chunk_row_count 
----------------------------------
 10000
(1 row)

SHOW kingres_columnar.write_buffer_memory;
 kingres_columnar.write_buffer_memory 
--------------------------------------
 128MB
(1 row)

SHOW kingres_columnar.enable_custom_scan;
 kingres_columnar.enable_custom_scan 
-------------------------------------
 on
(1 row)

SHOW kingres_columnar.enable_chunk_skipping;
 kingres_columnar.enable_chunk_skipping 
----------------------------------------
 on
(1 row)

-- values outside the range are refused
SET kingres_columnar.stripe_row_count = 999;
ERROR:  999 is outside the valid range for parameter "kingres_columnar.stripe_row_count" (1000 .. 10000000)
SET kingres_columnar.stripe_row_count = 10000001;
ERROR:  10000001 is outside the valid range for parameter "kingres_columnar.stripe_row_count" (1000 .. 10000000)
SET kingres_columnar.chunk_row_count = 99;
ERROR:  99 is outside the valid range for parameter "kingres_columnar.chunk_row_count" (100 .. 100000)
SET kingres_columnar.chunk_row_count = 100001;
ERROR:  100001 is outside the valid range for parameter "kingres_columnar.chunk_row_count" (100 .. 100000)
SET kingres_columnar.compression_level = 0;
ERROR:  0 is outside the valid range for parameter "kingres_columnar.compression_level" (1 .. 19)
SET kingres_columnar.compression_level = 20;
ERROR:  20 is outside the valid range for parameter "kingres_columnar.compression_level" (1 .. 19)
SET kingres_columnar.compression = 'gzip';
ERROR:  invalid value for parameter "kingres_columnar.compression": "gzip"
HINT:  Available values: auto, none, pglz, lz4, zstd.
SET kingres_columnar.compression = 'none';
SET kingres_columnar.compression = 'auto';
RESET kingres_columnar.compression;
SET kingres_columnar.no_such_setting = 1;
ERROR:  invalid configuration parameter name "kingres_columnar.no_such_setting"
DETAIL:  "kingres_columnar" is a reserved prefix.
-- a new table gets the defaults
CREATE TABLE setup_t (a int) USING columnar;
SELECT compression IN ('zstd', 'lz4', 'pglz') AS real_codec, compression_level,
       stripe_row_count, chunk_row_count
  FROM kingres.columnar_options('setup_t');
 real_codec | compression_level | stripe_row_count | chunk_row_count 
------------+-------------------+------------------+-----------------
 t          |                 3 |           150000 |           10000
(1 row)

SELECT c.relname, a.amname, c.relkind, c.relpersistence
  FROM pg_class c JOIN pg_am a ON a.oid = c.relam WHERE c.oid = 'setup_t'::regclass;
 relname |  amname  | relkind | relpersistence 
---------+----------+---------+----------------
 setup_t | columnar | r       | p
(1 row)

DROP TABLE setup_t;
-- the schema of the extension, the catalog and its privileges
SELECT relname, relkind, has_table_privilege('public', oid, 'SELECT') AS public_select
  FROM pg_class WHERE oid = 'kingres.columnar_stripe'::regclass;
     relname     | relkind | public_select 
-----------------+---------+---------------
 columnar_stripe | r       | f
(1 row)

SELECT count(*) AS catalog_rows FROM kingres.columnar_stripe;
 catalog_rows 
--------------
            0
(1 row)

-- the event triggers are always enabled
SELECT evtname, evtevent, evtenabled FROM pg_event_trigger
 WHERE evtname LIKE 'kingres\_columnar%' ORDER BY evtname;
          evtname           |    evtevent     | evtenabled 
----------------------------+-----------------+------------
 kingres_columnar_check_ddl | ddl_command_end | A
 kingres_columnar_on_drop   | sql_drop        | A
(2 rows)

