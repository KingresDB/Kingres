-- the same through a function that runs the inner query once for each outer row
SELECT o.k, a.* FROM outer_t o, LATERAL kc_agree('id = ' || coalesce(o.x::text, 'NULL')) a ORDER BY o.k;
 k | n | id_sum | agree 
---+---+--------+-------
 1 | 1 |    100 | t
 2 | 1 |   7000 | t
 3 | 1 |  12345 | t
