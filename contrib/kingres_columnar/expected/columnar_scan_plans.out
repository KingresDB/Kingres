 g3    |   300 | 449400
 g4    |   300 | 449700
 g5    |   300 | 450000
 g6    |   300 | 450300
 g7    |   300 | 450600
 g8    |   300 | 450900
 g9    |   300 | 451200
(10 rows)

RESET enable_mergejoin; RESET enable_nestloop;
SELECT (SELECT sum(c) FROM (SELECT label, count(*) c FROM sp JOIN dim USING (grp) GROUP BY label) x) AS joined_rows;
 joined_rows 
-------------
       20000
(1 row)

