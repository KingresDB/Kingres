--
-- schema_catalog.sql: phase 11 (distributed schemas), increment 1 (design/shard-phase11.md, 5.2 to 5.4, 10 and 15.1).
-- The catalog objects and their checks, the delta functions, kingres.schemas and kingres.buckets on hand-built rows,
-- schema_inventory for every kind of object, and the transitions of set_sharding_mode.  Nothing here creates a schema
-- group through the product (that is a later increment): the rows are made by the node-local delta functions.
\set SHOW_CONTEXT never
SET search_path = public, pg_temp;
CREATE EXTENSION kingres_shard;
SELECT kingres.init_cluster(btrim(split_part(current_setting('unix_socket_directories'), ',', 1)), current_setting('port')::int);
 init_cluster 
--------------
 
(1 row)

-- ---------------------------------------------------------------------------
-- The shape of the catalog
-- ---------------------------------------------------------------------------
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
  FROM pg_attribute WHERE attrelid = 'kingres.colocation'::regclass AND attnum > 0 AND NOT attisdropped ORDER BY attnum;
     attname      |  type   | attnotnull 
------------------+---------+------------
 colocation_id    | integer | t
 bucket_count     | integer | t
 dist_column_type | regtype | f
 dist_collation   | oid     | t
 max_modulus      | integer | t
 placement_epoch  | bigint  | t
 kind             | text    | t
(7 rows)

SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull, pg_get_expr(d.adbin, d.adrelid) AS default
  FROM pg_attribute a LEFT JOIN pg_attrdef d ON d.adrelid = a.attrelid AND d.adnum = a.attnum
 WHERE a.attrelid = 'kingres.dist_schema'::regclass AND a.attnum > 0 AND NOT a.attisdropped ORDER BY a.attnum;
    attname     |           type           | attnotnull | default 
----------------+--------------------------+------------+---------
 nsp            | regnamespace             | t          | 
 colocation_id  | integer                  | t          | 
 created_at     | timestamp with time zone | t          | now()
 ship_functions | boolean                  | t          | false
(4 rows)

SELECT * FROM kingres.sharding_settings;
 mode | distribute_new_schemas 
------+------------------------
 row  | f
(1 row)

SELECT conrelid::regclass AS tbl, conname, pg_get_constraintdef(oid) AS def FROM pg_constraint
 WHERE conrelid IN ('kingres.colocation'::regclass, 'kingres.dist_table'::regclass, 'kingres.dist_schema'::regclass, 'kingres.sharding_settings'::regclass)
   AND contype = 'c' ORDER BY 1::text, 2;
            tbl            |             conname             |                                                                                                                                        def                                                                                                                                         
---------------------------+---------------------------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 kingres.colocation        | colocation_bucket_count_check   | CHECK (((bucket_count >= 1) AND (bucket_count <= 4096)))
 kingres.colocation        | colocation_kind_check           | CHECK ((kind = ANY (ARRAY['hash'::text, 'schema'::text])))
 kingres.colocation        | colocation_kind_shape_check     | CHECK ((((kind = 'hash'::text) AND (dist_column_type IS NOT NULL)) OR ((kind = 'schema'::text) AND (dist_column_type IS NULL) AND (bucket_count = 1))))
 kingres.colocation        | colocation_max_modulus_check    | CHECK (((max_modulus >= 1) AND (max_modulus <= 65536)))
 kingres.dist_table        | dist_table_method_check         | CHECK ((method = ANY (ARRAY['hash'::text, 'reference'::text, 'schema'::text])))
 kingres.dist_table        | dist_table_partition_check      | CHECK ((((partition_method IS NULL) AND (partition_key IS NULL)) OR ((method = 'hash'::text) AND (partition_method = ANY (ARRAY['range'::text, 'list'::text])) AND (partition_key IS NOT NULL))))
 kingres.dist_table        | dist_table_shape_check          | CHECK ((((method = 'hash'::text) AND (dist_column IS NOT NULL) AND (colocation_id IS NOT NULL)) OR ((method = 'reference'::text) AND (dist_column IS NULL) AND (colocation_id IS NULL)) OR ((method = 'schema'::text) AND (dist_column IS NULL) AND (colocation_id IS NOT NULL))))
 kingres.sharding_settings | sharding_settings_default_check | CHECK (((distribute_new_schemas = false) OR (mode = ANY (ARRAY['schema'::text, 'both'::text]))))
 kingres.sharding_settings | sharding_settings_mode_check    | CHECK ((mode = ANY (ARRAY['row'::text, 'schema'::text, 'both'::text])))
(9 rows)

