SELECT kingres.internal_apply_catalog(jsonb_set(kingres.internal_catalog_snapshot(), '{colocation,0}',
       (kingres.internal_catalog_snapshot() -> 'colocation' -> 0) || '{"max_modulus": 8, "placement_epoch": 5}'));
