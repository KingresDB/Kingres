INSERT INTO kingres.node (node_id, group_id, host, port, role)
  VALUES (2, 1, '127.0.0.1', 1, 'primary');
UPDATE kingres.bucket_map SET group_id = 1 WHERE bucket % 2 = 1;
UPDATE kingres.bucket_map SET group_id = 1 WHERE colocation_id = (SELECT colocation_id FROM kingres.dist_table WHERE relid = 'away'::regclass) AND bucket % 2 = 0;
-- What the planner does with a statement: the line of its plan that names the path, or the error.
CREATE FUNCTION merge_verdict(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; r text := 'other'; dt text;
BEGIN
  FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
    IF l ~ 'Kingres|Pushed|Remote SQL|Source SQL|Nodes' THEN
      r := CASE WHEN r = 'other' THEN '' ELSE r || ' ## ' END
           || regexp_replace(regexp_replace(l, '^ *', ''), 'place=-?[0-9]+', 'place=N');
    END IF;
  END LOOP;
  RETURN r;
EXCEPTION WHEN OTHERS THEN
  GET STACKED DIAGNOSTICS dt = PG_EXCEPTION_DETAIL;
  RETURN 'ERROR: ' || SQLERRM || coalesce(' | ' || nullif(dt, ''), '');
END $$;
-- ---------------------------------------------------------------------------
-- With the switch off the statement meets the refusals of phase 2a.
-- ---------------------------------------------------------------------------
SET kingres_shard.enable_distributed_merge = off;
SELECT merge_verdict('MERGE INTO d USING s ON d.id = s.id WHEN MATCHED THEN UPDATE SET v = s.v');
                         merge_verdict                          
----------------------------------------------------------------
 ERROR: statements that span shard groups are not supported yet
(1 row)

RESET kingres_shard.enable_distributed_merge;
SHOW kingres_shard.enable_distributed_merge;
 kingres_shard.enable_distributed_merge 
----------------------------------------
 on
(1 row)

SHOW kingres_shard.merge_max_source_bytes;
 kingres_shard.merge_max_source_bytes 
--------------------------------------
 64MB
(1 row)

-- ---------------------------------------------------------------------------
-- The refusals of 7.2: each names the missing condition, before any group runs anything.
-- ---------------------------------------------------------------------------
-- a WITH clause
SELECT merge_verdict('WITH c AS (SELECT 1 AS x) MERGE INTO d USING s ON d.id = s.id WHEN MATCHED THEN DELETE');
                                             merge_verdict                                              
--------------------------------------------------------------------------------------------------------
 ERROR: this MERGE into distributed table "d" cannot be run on the shard groups | it has a WITH clause.
(1 row)

-- the distribution column is updated
SELECT merge_verdict('MERGE INTO d USING s ON d.id = s.id WHEN MATCHED THEN UPDATE SET id = s.id + 1');
                                                                                   merge_verdict                                                                                   
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 ERROR: this MERGE into distributed table "d" cannot be run on the shard groups | an UPDATE action assigns the distribution column (the row would have to move to another bucket).
(1 row)

-- the ON clause does not equate the key with something of the source
SELECT merge_verdict('MERGE INTO d USING plain p ON d.n = p.x WHEN MATCHED THEN DELETE');
                                                                                                   merge_verdict                                                                                                   
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 ERROR: this MERGE into distributed table "d" cannot be run on the shard groups | the ON clause of a MERGE into a distributed table must equate its distribution column with a column or expression of the source.
(1 row)

SELECT merge_verdict('MERGE INTO d USING (SELECT x FROM plain) p ON d.id > p.x WHEN MATCHED THEN DELETE');
                                                                                                   merge_verdict                                                                                                   
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 ERROR: this MERGE into distributed table "d" cannot be run on the shard groups | the ON clause of a MERGE into a distributed table must equate its distribution column with a column or expression of the source.
(1 row)

-- an INSERT action whose key is not the key the statement is routed by
SELECT merge_verdict('MERGE INTO d USING s ON d.id = s.id WHEN NOT MATCHED THEN INSERT (id, v) VALUES (s.id + 1, s.v)');
                                                                                                                          merge_verdict                                                                                                                           
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 ERROR: this MERGE into distributed table "d" cannot be run on the shard groups | the distribution column in a WHEN NOT MATCHED INSERT action is not the key that the statement is colocated or routed by (the inserted row would belong to another shard group).
(1 row)

SELECT merge_verdict('MERGE INTO d USING plain p ON d.id = p.x WHEN NOT MATCHED THEN INSERT (id, v) VALUES (p.x + 1, p.y)');
                                                                                                                          merge_verdict                                                                                                                           
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 ERROR: this MERGE into distributed table "d" cannot be run on the shard groups | the distribution column in a WHEN NOT MATCHED INSERT action is not the key that the statement is colocated or routed by (the inserted row would belong to another shard group).
(1 row)

-- no value for the key in the INSERT list
SELECT merge_verdict('MERGE INTO d USING plain p ON d.id = p.x WHEN NOT MATCHED THEN INSERT (v) VALUES (p.y)');
                                                                       merge_verdict                                                                       
-----------------------------------------------------------------------------------------------------------------------------------------------------------
 ERROR: this MERGE into distributed table "d" cannot be run on the shard groups | a WHEN NOT MATCHED INSERT action gives the distribution column no value.
(1 row)

-- a volatile value: each group would compute its own
SELECT merge_verdict('MERGE INTO d USING s ON d.id = s.id WHEN MATCHED THEN UPDATE SET v = random()::text');
                                                                                                                                     merge_verdict                                                                                                                                      
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 ERROR: this MERGE into distributed table "d" cannot be run on the shard groups | an action uses a volatile value (a sequence, an identity column, random()) that each group would compute for itself: give the column a value in the INSERT list, or use a value that is not volatile.
(1 row)

SELECT merge_verdict('MERGE INTO ser USING plain p ON ser.id = p.x WHEN NOT MATCHED THEN INSERT (id, a) VALUES (p.x, p.y)');
                                                                                                                                      merge_verdict                                                                                                                                       
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 ERROR: this MERGE into distributed table "ser" cannot be run on the shard groups | an action uses a volatile value (a sequence, an identity column, random()) that each group would compute for itself: give the column a value in the INSERT list, or use a value that is not volatile.
(1 row)

-- a sub-select in an expression
SELECT merge_verdict('MERGE INTO d USING s ON d.id = s.id WHEN MATCHED AND d.n > (SELECT max(x) FROM plain) THEN DELETE');
                                                                              merge_verdict                                                                              
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 ERROR: this MERGE into distributed table "d" cannot be run on the shard groups | it has a sub-select in an expression (ON, a WHEN condition, SET, VALUES or RETURNING).
(1 row)

-- an expression that is not built in and immutable
SELECT merge_verdict('MERGE INTO d USING plain p ON d.id = p.x WHEN MATCHED THEN UPDATE SET n = pg_backend_pid()');
                                                              merge_verdict                                                              
-----------------------------------------------------------------------------------------------------------------------------------------
 ERROR: this MERGE into distributed table "d" cannot be run on the shard groups | it uses a function that is not built in and immutable.
(1 row)

-- USING is a join: the source is not one relation
SELECT merge_verdict('MERGE INTO d USING plain p JOIN plain q ON p.x = q.x ON d.id = p.x WHEN MATCHED THEN DELETE');
                                                                                   merge_verdict                                                                                   
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 ERROR: this MERGE into distributed table "d" cannot be run on the shard groups | USING is a join or several relations; put it in a sub-select so that the source is one relation.
(1 row)

-- USING is the target itself, joined on something other than the key
SELECT merge_verdict('MERGE INTO d USING d dd ON d.n = dd.n WHEN MATCHED THEN DELETE');
                                                                                                   merge_verdict                                                                                                   
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 ERROR: this MERGE into distributed table "d" cannot be run on the shard groups | the ON clause of a MERGE into a distributed table must equate its distribution column with a column or expression of the source.
(1 row)

-- ---------------------------------------------------------------------------
-- M1, colocated (7.3): the statement runs whole on every group of the target.
-- ---------------------------------------------------------------------------
SELECT merge_verdict('MERGE INTO d USING s ON d.id = s.id WHEN MATCHED THEN UPDATE SET v = s.v');
                                                                                                                                             merge_verdict                                                                                                                                             
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Fan-out Write) ## Pushed: colocated MERGE (every group owning a bucket of the target runs it over its own buckets) ## Nodes: 2 ## Remote SQL: /* kingres:merge-fragment place=N rp=0 */ MERGE INTO public.d USING public.s ON (d.id = s.id) WHEN MATCHED THEN UPDATE SET v = s.v
(1 row)

SELECT merge_verdict('MERGE INTO d USING s ON d.id = s.id WHEN MATCHED AND s.n > 3 THEN DELETE WHEN NOT MATCHED THEN INSERT (id, v, n) VALUES (s.id, s.v, s.n)');
                                                                                                                                                                              merge_verdict                                                                                                                                                                              
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Fan-out Write) ## Pushed: colocated MERGE (every group owning a bucket of the target runs it over its own buckets) ## Nodes: 2 ## Remote SQL: /* kingres:merge-fragment place=N rp=0 */ MERGE INTO public.d USING public.s ON (d.id = s.id) WHEN MATCHED AND (s.n > 3) THEN DELETE WHEN NOT MATCHED THEN INSERT (id, v, n) VALUES (s.id, s.v, s.n)
(1 row)

SELECT merge_verdict('MERGE INTO d USING s JOIN o ON s.id = o.id ON d.id = s.id WHEN MATCHED THEN UPDATE SET v = o.w');
                                                                                                                                                              merge_verdict                                                                                                                                                               
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Fan-out Write) ## Pushed: colocated MERGE (every group owning a bucket of the target runs it over its own buckets) ## Nodes: 2 ## Remote SQL: /* kingres:merge-fragment place=N rp=0 */ MERGE INTO public.d USING (public.s JOIN public.o ON ((s.id = o.id))) ON (d.id = s.id) WHEN MATCHED THEN UPDATE SET v = o.w
(1 row)

-- only reference tables in USING, and an action on the target rows that no source row matches
SELECT merge_verdict('MERGE INTO d USING r ON d.n = r.k WHEN MATCHED THEN UPDATE SET v = r.label WHEN NOT MATCHED BY SOURCE THEN DELETE');
                                                                                                                                                                 merge_verdict                                                                                                                                                                  
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Fan-out Write) ## Pushed: colocated MERGE (every group owning a bucket of the target runs it over its own buckets) ## Nodes: 2 ## Remote SQL: /* kingres:merge-fragment place=N rp=0 */ MERGE INTO public.d USING public.r ON (d.n = r.k) WHEN MATCHED THEN UPDATE SET v = r.label WHEN NOT MATCHED BY SOURCE THEN DELETE
(1 row)

SELECT merge_verdict('MERGE INTO d USING s ON d.id = s.id WHEN MATCHED THEN UPDATE SET v = s.v RETURNING merge_action(), d.id');
                                                                                                                                                                     merge_verdict                                                                                                                                                                      
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Fan-out Write) ## Pushed: colocated MERGE (every group owning a bucket of the target runs it over its own buckets) ## Nodes: 2 ## Remote SQL: /* kingres:merge-fragment place=N rp=0 */ MERGE INTO public.d USING public.s ON (d.id = s.id) WHEN MATCHED THEN UPDATE SET v = s.v RETURNING MERGE_ACTION() AS "merge_action", d.id
(1 row)

-- ---------------------------------------------------------------------------
-- M3, routed source (7.4): the source is read here and each row goes to the group of its key.
-- ---------------------------------------------------------------------------
SELECT merge_verdict('MERGE INTO d USING plain p ON d.id = p.x WHEN NOT MATCHED THEN INSERT (id, v) VALUES (p.x, p.y)');
                                                                                                                                                                                                                                         merge_verdict                                                                                                                                                                                                                                         
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Fan-out Write) ## Pushed: MERGE with a routed source (this node reads the source and sends each row to the group of its key) ## Source SQL: SELECT p.x AS ks_c1, p.y AS ks_c2, p.x AS ks_route FROM public.plain p ## Nodes: 2 ## Remote SQL: /* kingres:merge-fragment place=N rp=1 */ MERGE INTO public.d USING ( SELECT (u.c1)::integer AS x, u.c2 AS y FROM UNNEST($1, $2) u(c1, c2)) p ON (d.id = p.x) WHEN NOT MATCHED THEN INSERT (id, v, n) VALUES (p.x, p.y, 7)
(1 row)

SELECT merge_verdict('MERGE INTO d USING (VALUES (1, ''a''), (2, ''b'')) AS v(k, t) ON d.id = v.k WHEN MATCHED THEN UPDATE SET v = v.t WHEN NOT MATCHED THEN INSERT (id, v) VALUES (v.k, v.t)');
                                                                                                                                                                                                                                                                              merge_verdict                                                                                                                                                                                                                                                                               
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Fan-out Write) ## Pushed: MERGE with a routed source (this node reads the source and sends each row to the group of its key) ## Source SQL: SELECT v.k AS ks_c1, v.t AS ks_c2, v.k AS ks_route FROM ( VALUES (1,'a'::text), (2,'b'::text)) v(k, t) ## Nodes: 2 ## Remote SQL: /* kingres:merge-fragment place=N rp=1 */ MERGE INTO public.d USING ( SELECT (u.c1)::integer AS k, u.c2 AS t FROM UNNEST($1, $2) u(c1, c2)) v(k, t) ON (d.id = v.k) WHEN MATCHED THEN UPDATE SET v = v.t WHEN NOT MATCHED THEN INSERT (id, v, n) VALUES (v.k, v.t, 7)
(1 row)

-- a table of another colocation group, a distributed table joined on a column other than its key,
-- a reference table that must give rows to a NOT MATCHED action
SELECT merge_verdict('MERGE INTO d USING away ON d.id = away.id WHEN MATCHED THEN DELETE');
                                                                                                                                                                                                                     merge_verdict                                                                                                                                                                                                                      
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Fan-out Write) ## Pushed: MERGE with a routed source (this node reads the source and sends each row to the group of its key) ## Source SQL: SELECT away.id AS ks_c1, away.id AS ks_route FROM public.away ## Nodes: 2 ## Remote SQL: /* kingres:merge-fragment place=N rp=1 */ MERGE INTO public.d USING ( SELECT (u.c1)::integer AS id, NULL::text AS w FROM unnest($1) u(c1)) away ON (d.id = away.id) WHEN MATCHED THEN DELETE
(1 row)

SELECT merge_verdict('MERGE INTO d USING s ON d.id = s.g WHEN MATCHED THEN DELETE');
                                                                                                                                                                                                                             merge_verdict                                                                                                                                                                                                                              
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Fan-out Write) ## Pushed: MERGE with a routed source (this node reads the source and sends each row to the group of its key) ## Source SQL: SELECT s.g AS ks_c1, s.g AS ks_route FROM public.s ## Nodes: 2 ## Remote SQL: /* kingres:merge-fragment place=N rp=1 */ MERGE INTO public.d USING ( SELECT NULL::text AS id, NULL::text AS v, NULL::text AS n, (u.c1)::integer AS g FROM unnest($1) u(c1)) s ON (d.id = s.g) WHEN MATCHED THEN DELETE
(1 row)

SELECT merge_verdict('MERGE INTO d USING r ON d.id = r.k WHEN NOT MATCHED THEN INSERT (id, v) VALUES (r.k, r.label)');
                                                                                                                                                                                                                                            merge_verdict                                                                                                                                                                                                                                            
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Fan-out Write) ## Pushed: MERGE with a routed source (this node reads the source and sends each row to the group of its key) ## Source SQL: SELECT r.k AS ks_c1, r.label AS ks_c2, r.k AS ks_route FROM public.r ## Nodes: 2 ## Remote SQL: /* kingres:merge-fragment place=N rp=1 */ MERGE INTO public.d USING ( SELECT (u.c1)::integer AS k, u.c2 AS label FROM UNNEST($1, $2) u(c1, c2)) r ON (d.id = r.k) WHEN NOT MATCHED THEN INSERT (id, v, n) VALUES (r.k, r.label, 7)
(1 row)

-- an aggregate as the source, with an action that no group may skip
SELECT merge_verdict('MERGE INTO d USING (SELECT g, count(*) AS c FROM s GROUP BY g) q ON d.id = q.g WHEN MATCHED THEN UPDATE SET n = q.c WHEN NOT MATCHED BY SOURCE THEN DELETE');
                                                                                                                                                                                                                                                                           merge_verdict                                                                                                                                                                                                                                                                           
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Fan-out Write) ## Pushed: MERGE with a routed source (this node reads the source and sends each row to the group of its key) ## Source SQL: SELECT q.g AS ks_c1, q.c AS ks_c2, q.g AS ks_route FROM ( SELECT s.g, count(*) AS c FROM public.s GROUP BY s.g) q ## Nodes: 2 ## Remote SQL: /* kingres:merge-fragment place=N rp=1 */ MERGE INTO public.d USING ( SELECT (u.c1)::integer AS g, (u.c2)::bigint AS c FROM UNNEST($1, $2) u(c1, c2)) q ON (d.id = q.g) WHEN MATCHED THEN UPDATE SET n = q.c WHEN NOT MATCHED BY SOURCE THEN DELETE
(1 row)

-- the key expression is an expression of the source
SELECT merge_verdict('MERGE INTO d USING plain p ON d.id = p.x + 1 WHEN MATCHED THEN DELETE');
                                                                                                                                                                                                                     merge_verdict                                                                                                                                                                                                                     
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Fan-out Write) ## Pushed: MERGE with a routed source (this node reads the source and sends each row to the group of its key) ## Source SQL: SELECT p.x AS ks_c1, (p.x + 1) AS ks_route FROM public.plain p ## Nodes: 2 ## Remote SQL: /* kingres:merge-fragment place=N rp=1 */ MERGE INTO public.d USING ( SELECT (u.c1)::integer AS x, NULL::text AS y FROM unnest($1) u(c1)) p ON (d.id = (p.x + 1)) WHEN MATCHED THEN DELETE
(1 row)

-- with a bound parameter
PREPARE mp(int) AS MERGE INTO d USING plain p ON d.id = p.x WHEN MATCHED AND p.x > $1 THEN DELETE;
SELECT merge_verdict('EXECUTE mp(3)');
                                                                                                                                                                                                                      merge_verdict                                                                                                                                                                                                                       
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Fan-out Write) ## Pushed: MERGE with a routed source (this node reads the source and sends each row to the group of its key) ## Source SQL: SELECT p.x AS ks_c1, p.x AS ks_route FROM public.plain p ## Nodes: 2 ## Remote SQL: /* kingres:merge-fragment place=N rp=1 */ MERGE INTO public.d USING ( SELECT (u.c1)::integer AS x, NULL::text AS y FROM unnest($2) u(c1)) p ON (d.id = p.x) WHEN MATCHED AND (p.x > $1) THEN DELETE
(1 row)

DEALLOCATE mp;
-- the switch of the setting
SET kingres_shard.enable_distributed_merge = off;
SELECT merge_verdict('MERGE INTO d USING plain p ON d.id = p.x WHEN MATCHED THEN DELETE');
                         merge_verdict                          
----------------------------------------------------------------
 ERROR: statements that span shard groups are not supported yet
(1 row)

RESET kingres_shard.enable_distributed_merge;
-- ---------------------------------------------------------------------------
-- Clean up
-- ---------------------------------------------------------------------------
UPDATE kingres.bucket_map SET group_id = 0;
DELETE FROM kingres.node WHERE node_id = 2;
DROP TABLE s, d, o, away, r, plain, ser;
DROP FUNCTION merge_verdict(text);
DROP EXTENSION kingres_shard;
