   Target: public.d
   Batch rows: 1000
   Source: SELECT (id)::integer AS id, (w)::text AS v FROM ( SELECT s.id, o.w FROM (public.s JOIN public.o ON ((o.id = s.n)))) ks_src
(4 rows)

EXPLAIN (COSTS OFF) INSERT INTO d (id, v) SELECT s.id, a.w FROM s JOIN away a ON a.id = s.id;
DEBUG:  kingres_shard: INSERT ... SELECT is not shipped whole: it reads distributed tables of more than one colocation group
                                                                 QUERY PLAN                                                                 
--------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Row Router)
   Target: public.d
   Batch rows: 1000
