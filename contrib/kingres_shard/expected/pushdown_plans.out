(4 rows)

EXPLAIN (COSTS OFF) INSERT INTO d (id, v) SELECT n, 'x' FROM s GROUP BY n;
DEBUG:  kingres_shard: INSERT ... SELECT is not shipped whole: its grouping does not include a distribution key (a group would span shard groups)
                                                         QUERY PLAN                                                          
-----------------------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Row Router)
   Target: public.d
   Batch rows: 1000
   Source: SELECT (n)::integer AS id, 'x'::text AS v FROM ( SELECT s.n, 'x' AS "?column?" FROM public.s GROUP BY s.n) ks_src
(4 rows)

EXPLAIN (COSTS OFF) INSERT INTO d (id, v) SELECT id, v FROM s LIMIT 5;
DEBUG:  kingres_shard: INSERT ... SELECT is not shipped whole: it has LIMIT or OFFSET, which picks rows by their order
                                                 QUERY PLAN                                                 
------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Row Router)
   Target: public.d
   Batch rows: 1000
   Source: SELECT (id)::integer AS id, (v)::text AS v FROM ( SELECT s.id, s.v FROM public.s LIMIT 5) ks_src
(4 rows)

EXPLAIN (COSTS OFF) INSERT INTO d (id, v) SELECT id, v FROM s WHERE id IN (SELECT id FROM o);
DEBUG:  kingres_shard: INSERT ... SELECT is not shipped whole: it has a sub-select in an expression
                                                                   QUERY PLAN                                                                    
-------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Row Router)
   Target: public.d
   Batch rows: 1000
   Source: SELECT (id)::integer AS id, (v)::text AS v FROM ( SELECT s.id, s.v FROM public.s WHERE (s.id IN ( SELECT o.id FROM public.o))) ks_src
(4 rows)

EXPLAIN (COSTS OFF) INSERT INTO d (id, v) SELECT x, y FROM plain;
DEBUG:  kingres_shard: INSERT ... SELECT is not shipped whole: it reads a local table, which the other shard groups do not have
                                                  QUERY PLAN                                                  
--------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Row Router)
   Target: public.d
   Batch rows: 1000
   Source: SELECT (x)::integer AS id, (y)::text AS v FROM ( SELECT plain.x, plain.y FROM public.plain) ks_src
(4 rows)

EXPLAIN (COSTS OFF) INSERT INTO ser (id, a) SELECT id, v FROM s;
DEBUG:  kingres_shard: INSERT ... SELECT is not shipped whole: a column that the statement does not name has a volatile default (a sequence, an identity column), which is computed once per row at the origin
                                                                        QUERY PLAN                                                                         
-----------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Row Router)
   Target: public.ser
   Batch rows: 1000
   Source: SELECT (id)::integer AS id, (v)::text AS a, (nextval('public.ser_q_seq'::regclass))::integer AS q FROM ( SELECT s.id, s.v FROM public.s) ks_src
(4 rows)

EXPLAIN (COSTS OFF) INSERT INTO d (id, v) SELECT id, v FROM s ON CONFLICT (id) DO UPDATE SET id = excluded.id;
DEBUG:  kingres_shard: INSERT ... SELECT is not shipped whole: its ON CONFLICT DO UPDATE assigns the distribution column
ERROR:  ON CONFLICT DO UPDATE is not supported yet for an INSERT that goes to several shard groups
RESET client_min_messages;
\set VERBOSITY default
