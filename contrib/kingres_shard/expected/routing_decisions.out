  AS $$ BEGIN RETURN (SELECT count(*) FROM t); END $$;
CREATE FUNCTION t_one_pl(k int) RETURNS text LANGUAGE plpgsql
  AS $$ BEGIN RETURN (SELECT v FROM t WHERE id = k); END $$;
