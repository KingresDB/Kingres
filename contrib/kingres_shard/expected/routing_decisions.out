DROP VIEW t_view;
DROP TABLE ctas2, plain;
DROP FUNCTION t_count(), t_rows(), t_by_id(int), t_v(int), t_count_pl(),
  t_one_pl(int), plain_trg(), t_par(int);
DROP TABLE w, wc, t;
DROP COLLATION ci;
DROP EXTENSION kingres_shard;
