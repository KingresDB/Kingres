-- a parallel worker may not forward a statement
CREATE FUNCTION t_par(k int) RETURNS bigint LANGUAGE plpgsql STABLE PARALLEL SAFE
  AS $$ BEGIN RETURN (SELECT count(*) FROM t WHERE id = k); END $$;
SET debug_parallel_query = on;
SELECT t_par(:tl);
 t_par 
-------
     1
(1 row)

SELECT t_par(:tr);
ERROR:  a statement for another shard group cannot be forwarded from a parallel worker
HINT:  Mark the function that runs the statement PARALLEL RESTRICTED or PARALLEL UNSAFE.
RESET debug_parallel_query;
-- SPI from C goes through the same hook: pg_catalog functions that run
-- queries on their own are not distributed-table aware, so only the
-- statements above matter.
-- ---------------------------------------------------------------------------
-- Finding 1: in a forwarded session a statement runs only if every bucket it
-- can touch is local; otherwise KS001.  The flag is set by the connection
-- options of a forwarded session and cannot be changed later.
-- ---------------------------------------------------------------------------
-- The session proves that it is forwarded with a token made from the cluster secret.
SELECT format('options=''-c kingres_shard.forwarded=on -c kingres_shard.forward_token=%s''', kingres.internal_forward_token(current_user, 1)) AS fwd_opts \gset
\c -reuse-previous=on :fwd_opts
SET search_path = public;
SHOW kingres_shard.forwarded;
 kingres_shard.forwarded 
-------------------------
 on
(1 row)

SELECT v FROM t WHERE id = :tl;
   v   
-------
 row 1
(1 row)

SELECT * FROM t;
ERROR:  cannot prove that the statement touches only buckets of this node
DETAIL:  Distributed table public.t is not restricted to one bucket, and shard group 0 does not own every bucket of its colocation group.
HINT:  A session opened by another node runs a statement locally only when every bucket the statement can touch is on this node.
SELECT v FROM t WHERE id = :tr;
ERROR:  bucket 1 of public.t is not on this node (stale map version 15)
SELECT count(*) FROM t WHERE id = :tl OR id = :tr;
ERROR:  cannot prove that the statement touches only buckets of this node
DETAIL:  Distributed table public.t is not restricted to one bucket, and shard group 0 does not own every bucket of its colocation group.
HINT:  A session opened by another node runs a statement locally only when every bucket the statement can touch is on this node.
UPDATE t SET v = 'x';
ERROR:  cannot prove that the statement touches only buckets of this node
DETAIL:  Distributed table public.t is not restricted to one bucket, and shard group 0 does not own every bucket of its colocation group.
HINT:  A session opened by another node runs a statement locally only when every bucket the statement can touch is on this node.
DELETE FROM t;
