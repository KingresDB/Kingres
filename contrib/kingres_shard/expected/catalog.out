-- The settings the extension defines.
SELECT name, setting, unit, context
  FROM pg_settings WHERE name LIKE 'kingres_shard.%' ORDER BY name;
                     name                     | setting | unit |  context  
----------------------------------------------+---------+------+-----------
 kingres_shard.add_node_batch_statements      | 100     |      | superuser
 kingres_shard.catalog_incremental            | on      |      | superuser
 kingres_shard.control_call_timeout           | 0       | s    | user
 kingres_shard.count_distinct_error_rate      | 0.01    |      | user
 kingres_shard.count_distinct_mode            | exact   |      | user
 kingres_shard.deadlock_check_interval        | 0       | s    | sighup
 kingres_shard.deadlock_confirm_delay         | 200     | ms   | sighup
 kingres_shard.decision_retention             | 300     | s    | sighup
 kingres_shard.default_bucket_count           | 128     |      | user
 kingres_shard.dependent_views                | refuse  |      | user
 kingres_shard.distribute_new_schemas         | default |      | superuser
 kingres_shard.enable_bulk_routing            | on      |      | user
 kingres_shard.enable_colocated_insert_select | on      |      | user
 kingres_shard.enable_copy_routing            | on      |      | user
 kingres_shard.enable_distributed_merge       | on      |      | user
 kingres_shard.enable_distributed_scan        | on      |      | user
 kingres_shard.enable_partial_aggregation     | on      |      | user
 kingres_shard.enable_pushdown                | on      |      | user
 kingres_shard.enable_pushdown_closed         | on      |      | user
 kingres_shard.enable_pushdown_join           | on      |      | user
 kingres_shard.enable_pushdown_sort           | on      |      | user
 kingres_shard.enable_repartition_join        | on      |      | user
 kingres_shard.enable_routing                 | on      |      | superuser
 kingres_shard.enable_schema_routing          | on      |      | user
 kingres_shard.fault_injection                |         |      | superuser
 kingres_shard.forwarded                      | off     |      | backend
 kingres_shard.insert_batch_bytes             | 1048576 | B    | user
 kingres_shard.insert_batch_rows              | 1000    |      | user
 kingres_shard.max_distributed_schemas        | 10000   |      | sighup
 kingres_shard.max_partition_leaves           | 8192    |      | user
 kingres_shard.merge_max_source_bytes         | 65536   | kB   | user
 kingres_shard.min_bucket_cost                | 1024    | kB   | user
 kingres_shard.move_catchup_threshold         | 1024    | kB   | user
 kingres_shard.move_cleanup_delay             | 600     | s    | user
 kingres_shard.move_switch_attempts           | 20      |      | user
 kingres_shard.move_switch_timeout            | 10000   | ms   | user
 kingres_shard.node_connect_timeout           | 5       | s    | user
 kingres_shard.node_conninfo                  |         |      | sighup
 kingres_shard.node_timeout                   | 60      | s    | user
 kingres_shard.rebuild_batch_rows             | 10000   |      | user
 kingres_shard.rebuild_drain_threshold        | 1000    |      | user
 kingres_shard.rebuild_lock_timeout           | 200     | ms   | user
 kingres_shard.rebuild_switch_max_attempts    | 30      |      | user
 kingres_shard.rebuild_switch_timeout         | 10000   | ms   | user
 kingres_shard.rebuild_verify                 | on      |      | user
 kingres_shard.recovery_interval              | 0       | s    | sighup
 kingres_shard.repartition_max_bytes          | 65536   | kB   | user
 kingres_shard.scan_fetch_size                | 1000    |      | user
 kingres_shard.schema_placement_group         | -1      |      | superuser
 kingres_shard.shippable_extensions           | all     |      | user
 kingres_shard.table_cleanup_delay            | 600     | s    | user
(51 rows)

SET kingres_shard.default_bucket_count = 0;
ERROR:  0 is outside the valid range for parameter "kingres_shard.default_bucket_count" (1 .. 4096)
SET kingres_shard.default_bucket_count = 4097;
ERROR:  4097 is outside the valid range for parameter "kingres_shard.default_bucket_count" (1 .. 4096)
SET kingres_shard.nonexistent = 1;
ERROR:  invalid configuration parameter name "kingres_shard.nonexistent"
DETAIL:  "kingres_shard" is a reserved prefix.
DROP EXTENSION kingres_shard;
-- The schema is shared with the other KingresDB extensions and belongs to none of them:
-- it stays, empty, when the extension goes.
SELECT count(*) AS schema_left FROM pg_namespace WHERE nspname = 'kingres';
 schema_left 
-------------
           1
(1 row)

SELECT (SELECT count(*) FROM pg_class WHERE relnamespace = 'kingres'::regnamespace)
     + (SELECT count(*) FROM pg_proc WHERE pronamespace = 'kingres'::regnamespace) AS objects_left;
 objects_left 
--------------
            0
(1 row)

DROP SCHEMA kingres;
