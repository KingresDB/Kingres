-- Catalog creation, constraints, map_version triggers and GUCs.
CREATE EXTENSION kingres_shard;
SELECT c.relname
  FROM pg_class c
  WHERE c.relnamespace = 'kingres'::regnamespace AND c.relkind = 'r'
  ORDER BY 1;
