-- Nothing is created outside the kingres schema.
SELECT count(*) AS tables_outside_kingres
  FROM pg_depend d
  JOIN pg_extension e ON e.oid = d.refobjid AND d.refclassid = 'pg_extension'::regclass
  JOIN pg_class c ON c.oid = d.objid AND d.classid = 'pg_class'::regclass
  WHERE e.extname = 'kingres_shard' AND c.relnamespace <> 'kingres'::regnamespace;
 tables_outside_kingres 
------------------------
                      0
(1 row)

-- The map version starts at zero and every changing statement increments it.
SELECT version FROM kingres.map_version;
 version 
---------
       0
(1 row)

INSERT INTO kingres.node (node_id, group_id, host, port, role)
  VALUES (1, 0, 'a.example', 5432, 'primary'), (2, 1, 'b.example', 5432, 'primary');
SELECT version FROM kingres.map_version;
 version 
---------
       1
(1 row)

UPDATE kingres.node SET is_active = false WHERE node_id = 2;
SELECT version FROM kingres.map_version;
 version 
---------
       2
(1 row)

INSERT INTO kingres.colocation VALUES (1, 8, 'int4', 0);
SELECT version FROM kingres.map_version;
 version 
---------
       3
(1 row)

INSERT INTO kingres.bucket_map (colocation_id, bucket, group_id)
  SELECT 1, g, g % 2 FROM generate_series(0, 7) g;
SELECT version FROM kingres.map_version;
 version 
---------
       4
(1 row)

DELETE FROM kingres.node WHERE node_id = 2;
SELECT version FROM kingres.map_version;
 version 
---------
       5
(1 row)

-- A statement that changes no row still counts: the trigger is per statement.
DELETE FROM kingres.node WHERE node_id = 99;
SELECT version FROM kingres.map_version;
 version 
---------
       6
(1 row)

-- Constraints.
INSERT INTO kingres.node (node_id, group_id, host, port, role)
  VALUES (3, 0, 'a.example', 5432, 'primary');
ERROR:  duplicate key value violates unique constraint "node_host_port_key"
DETAIL:  Key (host, port)=(a.example, 5432) already exists.
INSERT INTO kingres.node (node_id, group_id, host, port, role)
  VALUES (3, 0, 'c.example', 5432, 'leader');
ERROR:  new row for relation "node" violates check constraint "node_role_check"
DETAIL:  Failing row contains (3, 0, c.example, 5432, leader, t, t, null, 1).
INSERT INTO kingres.node (node_id, group_id, host, port, role)
  VALUES (3, -1, 'c.example', 5432, 'primary');
ERROR:  new row for relation "node" violates check constraint "node_group_id_check"
DETAIL:  Failing row contains (3, -1, c.example, 5432, primary, t, t, null, 1).
INSERT INTO kingres.node (node_id, group_id, host, port, role)
  VALUES (3, 0, 'c.example', 70000, 'primary');
ERROR:  new row for relation "node" violates check constraint "node_port_check"
DETAIL:  Failing row contains (3, 0, c.example, 70000, primary, t, t, null, 1).
INSERT INTO kingres.colocation VALUES (2, 0, 'int4', 0);
ERROR:  new row for relation "colocation" violates check constraint "colocation_bucket_count_check"
DETAIL:  Failing row contains (2, 0, integer, 0, 0, 0, hash).
INSERT INTO kingres.colocation VALUES (2, 4097, 'int4', 0);
ERROR:  new row for relation "colocation" violates check constraint "colocation_bucket_count_check"
DETAIL:  Failing row contains (2, 4097, integer, 0, 4097, 0, hash).
INSERT INTO kingres.bucket_map VALUES (9, 0, 0);
ERROR:  insert or update on table "bucket_map" violates foreign key constraint "bucket_map_colocation_id_fkey"
DETAIL:  Key (colocation_id)=(9) is not present in table "colocation".
INSERT INTO kingres.bucket_map VALUES (1, 0, 0);
ERROR:  duplicate key value violates unique constraint "bucket_map_pkey"
DETAIL:  Key (colocation_id, bucket)=(1, 0) already exists.
INSERT INTO kingres.bucket_map VALUES (1, 2, 0, 'broken');
ERROR:  new row for relation "bucket_map" violates check constraint "bucket_map_state_check"
DETAIL:  Failing row contains (1, 2, 0, broken, 8).
-- the bucket layout of 0.8: a bucket is below its modulus, a modulus divides max_modulus of the group
INSERT INTO kingres.bucket_map VALUES (1, 20, 0, 'active');
ERROR:  new row for relation "bucket_map" violates check constraint "bucket_map_modulus_check"
DETAIL:  Failing row contains (1, 20, 0, active, 8).
INSERT INTO kingres.bucket_map VALUES (1, 0, 0, 'active', 0);
ERROR:  new row for relation "bucket_map" violates check constraint "bucket_map_modulus_check"
DETAIL:  Failing row contains (1, 0, 0, active, 0).
INSERT INTO kingres.colocation VALUES (2, 4, 'int4', 0, 0);
ERROR:  new row for relation "colocation" violates check constraint "colocation_max_modulus_check"
DETAIL:  Failing row contains (2, 4, integer, 0, 0, 0, hash).
INSERT INTO kingres.colocation VALUES (2, 4, 'int4', 0, 65537);
ERROR:  new row for relation "colocation" violates check constraint "colocation_max_modulus_check"
DETAIL:  Failing row contains (2, 4, integer, 0, 65537, 0, hash).
INSERT INTO kingres.dist_table VALUES ('pg_class'::regclass, 'range', 'oid', 1);
ERROR:  new row for relation "dist_table" violates check constraint "dist_table_method_check"
DETAIL:  Failing row contains (pg_class, range, oid, 1, null, null, null).
INSERT INTO kingres.dist_table VALUES ('pg_class'::regclass, 'hash', 'oid', 9);
ERROR:  insert or update on table "dist_table" violates foreign key constraint "dist_table_colocation_id_fkey"
DETAIL:  Key (colocation_id)=(9) is not present in table "colocation".
INSERT INTO kingres.map_version VALUES (5);
ERROR:  duplicate key value violates unique constraint "map_version_single_row_idx"
DETAIL:  Key ((true))=(t) already exists.
INSERT INTO kingres.local_node VALUES (1);
INSERT INTO kingres.local_node VALUES (2);
ERROR:  duplicate key value violates unique constraint "local_node_single_row_idx"
DETAIL:  Key ((true))=(t) already exists.
