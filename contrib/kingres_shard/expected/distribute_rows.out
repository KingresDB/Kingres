SELECT tableoid::regclass::text = format('orders_b%s', lpad(kingres.bucket_for('orders'::regclass, parent)::text, 4, '0')) AS in_bucket_of_parent, count(*) FROM orders GROUP BY 1;
 in_bucket_of_parent | count 
---------------------+-------
 t                   |    50
