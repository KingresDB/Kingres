-- every row is in the partition of its own bucket, and nowhere else
SELECT count(*) FILTER (WHERE tableoid::regclass::text = format('items_b%s', lpad(kingres.bucket_for('items'::regclass, id)::text, 4, '0'))) AS in_own_bucket,
       count(*) AS total
  FROM items;
