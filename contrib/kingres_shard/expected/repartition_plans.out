-- ---------------------------------------------------------------------------
-- The switches
-- ---------------------------------------------------------------------------
SET kingres_shard.enable_repartition_join = off;
SELECT pushed('SELECT o.id, cu.name FROM o JOIN cu ON cu.id = o.cust');
 pushed 
--------
 none
(1 row)

SET kingres_shard.enable_repartition_join = on;
SELECT pushed('SELECT o.id, cu.name FROM o JOIN cu ON cu.id = o.cust');
 pushed 
--------
 none
(1 row)

SET kingres_shard.repartition_max_bytes = 1024;
SELECT pushed('SELECT o.id, cu.name FROM o JOIN cu ON cu.id = o.cust');
 pushed 
--------
 none
(1 row)

RESET kingres_shard.repartition_max_bytes;
SET jit = off;
SET kingres_shard.enable_repartition_join = force;
SET kingres_shard.enable_pushdown = off;
SELECT pushed('SELECT o.id, cu.name FROM o JOIN cu ON cu.id = o.cust');
 pushed 
--------
 none
(1 row)

RESET kingres_shard.enable_pushdown;
-- ---------------------------------------------------------------------------
-- The statements that are not repartitioned, and why (DEBUG1 of the planner): the complete scan answers them
-- ---------------------------------------------------------------------------
SET client_min_messages = debug1;
\echo -- an outer join other than one LEFT JOIN to a table
-- an outer join other than one LEFT JOIN to a table
SELECT pushed('SELECT o.id, cu.name FROM o FULL JOIN cu ON cu.id = o.cust');
DEBUG:  kingres_shard: no pushdown: a FULL JOIN of distributed tables does not equate their distribution keys in its ON clause
DEBUG:  kingres_shard: no repartitioned join: it has an outer join that a repartitioned join does not run (only a LEFT JOIN to one table)
 pushed 
--------
 none
(1 row)

SELECT pushed('SELECT cu.id, o.id FROM cu LEFT JOIN o ON o.cust = cu.id LEFT JOIN it ON it.id = cu.id');
DEBUG:  kingres_shard: no pushdown: an outer join of distributed tables does not equate their distribution keys in its ON clause
DEBUG:  kingres_shard: no repartitioned join: it has an outer join other than one LEFT JOIN to a table
 pushed 
--------
 none
(1 row)

\echo -- the moved table would be the preserved side
-- the moved table would be the preserved side
SELECT pushed('SELECT o.id, cu.name FROM o LEFT JOIN cu ON cu.id = o.cust');
DEBUG:  kingres_shard: no pushdown: an outer join of distributed tables does not equate their distribution keys in its ON clause
DEBUG:  kingres_shard: no repartitioned join: with a LEFT JOIN only the table on its nullable side can be moved, and the others do not leave it one key class to be aligned with
 pushed 
--------
 none
(1 row)

\echo -- a join on an expression, a join that is not an equality
-- a join on an expression, a join that is not an equality
SELECT pushed('SELECT o.id, cu.name FROM o JOIN cu ON cu.id = o.cust + 1');
DEBUG:  kingres_shard: no pushdown: the distributed tables are not all joined on their distribution keys (more than one key class)
DEBUG:  kingres_shard: no repartitioned join: the distributed tables are not joined so that one repartition aligns them (the other tables must share one key class and the shipped table must equate a column with it)
 pushed 
--------
 none
(1 row)

SELECT pushed('SELECT o.id, cu.id FROM o JOIN cu ON cu.region < o.amount');
DEBUG:  kingres_shard: no pushdown: the distributed tables are not all joined on their distribution keys (more than one key class)
DEBUG:  kingres_shard: no repartitioned join: the distributed tables are not joined so that one repartition aligns them (the other tables must share one key class and the shipped table must equate a column with it)
 pushed 
--------
 none
(1 row)

