-- the ON clause of a LEFT JOIN does not align the tables that stay with each other
SELECT pushed('SELECT o.id, it.id, cu.id FROM o CROSS JOIN it LEFT JOIN cu ON cu.region = o.id AND cu.region = it.id');
DEBUG:  kingres_shard: no pushdown: an outer join of distributed tables does not equate their distribution keys in its ON clause
DEBUG:  kingres_shard: no repartitioned join: the distributed tables are not all joined on their distribution keys (more than one key class)
 pushed 
--------
 none
(1 row)

SELECT pushed('SELECT o.id, it.id, cu.id FROM o CROSS JOIN it LEFT JOIN cu ON o.id = it.id AND cu.region = o.id');
DEBUG:  kingres_shard: no pushdown: an outer join of distributed tables does not equate their distribution keys in its ON clause
DEBUG:  kingres_shard: no repartitioned join: the distributed tables are not all joined on their distribution keys (more than one key class)
 pushed 
--------
 none
(1 row)

\echo -- a table that is not distributed
-- a table that is not distributed
SELECT pushed('SELECT o.id, plain.y FROM o JOIN plain ON plain.x = o.cust');
DEBUG:  kingres_shard: no pushdown: it reads a local table, which the other shard groups do not have
DEBUG:  kingres_shard: no repartitioned join: it reads a local table, which the other shard groups do not have
 pushed 
--------
 none
(1 row)

RESET client_min_messages;
\echo -- a sub-select in the statement
-- a sub-select in the statement
SELECT pushed('SELECT o.id FROM o JOIN cu ON cu.id = o.cust WHERE o.amount > (SELECT avg(amount) FROM o)');
 pushed 
--------
 none
(1 row)

-- ---------------------------------------------------------------------------
-- EXPLAIN (VERBOSE) names the reason when a statement that was a candidate is not repartitioned (design 4.12)
-- ---------------------------------------------------------------------------
\echo -- the statements of the section above, one reason each ("-" when the plan has no such line)
-- the statements of the section above, one reason each ("-" when the plan has no such line)
SELECT why('SELECT o.id, cu.name FROM o FULL JOIN cu ON cu.id = o.cust');
                                                        why                                                         
--------------------------------------------------------------------------------------------------------------------
 Repartition: not used: it has an outer join that a repartitioned join does not run (only a LEFT JOIN to one table)
(1 row)

SELECT why('SELECT cu.id, o.id FROM cu LEFT JOIN o ON o.cust = cu.id LEFT JOIN it ON it.id = cu.id');
                                       why                                       
---------------------------------------------------------------------------------
 Repartition: not used: it has an outer join other than one LEFT JOIN to a table
(1 row)

\echo -- a statement planned after one that had a reason does not inherit it (a local table beside a distributed one, on the other group)
-- a statement planned after one that had a reason does not inherit it (a local table beside a distributed one, on the other group)
SELECT id, why('SELECT o.id, plain.y FROM o JOIN plain ON plain.x = o.id WHERE o.id = ' || id) FROM generate_series(1, 6) id;
 id | why 
----+-----
  1 | -
  2 | -
  3 | -
  4 | -
  5 | -
  6 | -
(6 rows)

SELECT why('SELECT o.id, cu.name FROM o LEFT JOIN cu ON cu.id = o.cust');
                                                                            why                                                                            
-----------------------------------------------------------------------------------------------------------------------------------------------------------
 Repartition: not used: with a LEFT JOIN only the table on its nullable side can be moved, and the others do not leave it one key class to be aligned with
(1 row)

SELECT why('SELECT o.id, cu.name FROM o JOIN cu ON cu.id = o.cust + 1');
                                                                                               why                                                                                               
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Repartition: not used: the distributed tables are not joined so that one repartition aligns them (the other tables must share one key class and the shipped table must equate a column with it)
(1 row)

SELECT why('SELECT o.id, it.id FROM o JOIN it ON it.sku = o.amount');
                                                                                               why                                                                                               
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Repartition: not used: the distributed tables are not joined so that one repartition aligns them (the other tables must share one key class and the shipped table must equate a column with it)
(1 row)

SELECT why('SELECT o.id, plain.y FROM o JOIN plain ON plain.x = o.cust');
 why 
-----
 -
(1 row)

\echo -- the setting is off; a small bound, where the scan is cheaper by cost
-- the setting is off; a small bound, where the scan is cheaper by cost
SET kingres_shard.enable_repartition_join = off;
SELECT why('SELECT o.id, cu.name FROM o JOIN cu ON cu.id = o.cust');
                                     why                                      
------------------------------------------------------------------------------
 Repartition: not used: switched off by kingres_shard.enable_repartition_join
(1 row)

SET kingres_shard.enable_repartition_join = on;
SET kingres_shard.repartition_max_bytes = 1024;
SELECT why('SELECT o.id, cu.name FROM o JOIN cu ON cu.id = o.cust');
                                    why                                     
----------------------------------------------------------------------------
 Repartition: not used: cost: the scan is cheaper than a repartitioned plan
(1 row)

RESET kingres_shard.repartition_max_bytes;
SET kingres_shard.enable_repartition_join = force;
\echo -- not a candidate (one distributed table), or repartitioned: no line
-- not a candidate (one distributed table), or repartitioned: no line
SELECT why('SELECT o.id FROM o WHERE o.amount > 3');
 why 
-----
 -
(1 row)

SELECT why('SELECT o.id, cu.name FROM o JOIN cu ON cu.id = o.cust');
 why 
-----
 -
(1 row)

\echo -- the used form (no VERBOSE) names the moved table, its key and the placement
-- the used form (no VERBOSE) names the moved table, its key and the placement
SELECT * FROM plan_of('SELECT o.id, cu.name FROM o JOIN cu ON cu.id = o.cust') LIMIT 3;
                              plan_of                              
-------------------------------------------------------------------
 Custom Scan (Kingres Fragment Scan)
   Pushed: repartitioned join (one table moved by its join key)
   Repartition: o by cust -> placement of colocation 1 (8 buckets)
(3 rows)

-- ---------------------------------------------------------------------------
-- Clean up
-- ---------------------------------------------------------------------------
RESET jit;
RESET kingres_shard.enable_repartition_join;
RESET kingres_shard.enable_partial_aggregation;
UPDATE kingres.bucket_map SET group_id = 0;
DELETE FROM kingres.node WHERE node_id = 2;
DROP TABLE o, cu, it, far, r, plain;
DROP FUNCTION plan_of(text);
DROP FUNCTION pushed(text);
DROP FUNCTION why(text);
DROP EXTENSION kingres_shard;
