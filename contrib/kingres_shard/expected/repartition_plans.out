-- ---------------------------------------------------------------------------
-- Aggregates above the join: every group aggregates its rows of the join, this node combines
-- ---------------------------------------------------------------------------
\echo -- a grouped aggregate, an aggregate without grouping, HAVING, ORDER BY with LIMIT
-- a grouped aggregate, an aggregate without grouping, HAVING, ORDER BY with LIMIT
SELECT * FROM plan_of('SELECT cu.region, count(*), sum(o.amount) FROM o JOIN cu ON cu.id = o.cust GROUP BY cu.region');
                                                                                                                                  plan_of                                                                                                                                   
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Finalize HashAggregate
   Group Key: region
   ->  Custom Scan (Kingres Fragment Scan)
         Pushed: repartitioned join, partial aggregate (one table moved by its join key)
         Repartition: o by cust -> placement of colocation 1 (8 buckets)
         Groups: 2 of 2 (local + 1 remote)
         Remote SQL: SELECT cu.region, count(*), sum(o.amount) FROM (( SELECT NULL::text AS id, (u.c1)::integer AS cust, (u.c2)::integer AS amount, NULL::text AS note FROM UNNEST($1, $2) u(c1, c2)) o JOIN public.cu ON ((cu.id = o.cust))) WHERE true GROUP BY cu.region
         ->  Custom Scan (Kingres Distributed Scan)
               Remote groups: 1
               Remote SQL: SELECT amount, cust FROM public.o AS ks_t
               ->  Append
                     ->  Seq Scan on o_b0000 o_1
                     ->  Seq Scan on o_b0001 o_2
                     ->  Seq Scan on o_b0002 o_3
                     ->  Seq Scan on o_b0003 o_4
                     ->  Seq Scan on o_b0004 o_5
                     ->  Seq Scan on o_b0005 o_6
                     ->  Seq Scan on o_b0006 o_7
                     ->  Seq Scan on o_b0007 o_8
(19 rows)

