 create_reference_table 
------------------------
 
(1 row)

INSERT INTO kingres.node (node_id, group_id, host, port, role)
  VALUES (2, 1, '127.0.0.1', 1, 'primary');
UPDATE kingres.bucket_map SET group_id = 1 WHERE bucket % 2 = 1;
-- The plan of a statement, one line per row, with the placement number (a hash of the map) hidden.
CREATE FUNCTION plan_of(q text) RETURNS SETOF text LANGUAGE plpgsql AS $$
DECLARE l text;
BEGIN
  FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
    RETURN NEXT regexp_replace(l, 'place=-?[0-9]+', 'place=N');
  END LOOP;
END $$;
-- What is pushed: the "Pushed" line of the plan, or "none"
CREATE FUNCTION pushed(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; r text := 'none';
BEGIN
  FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
    IF l LIKE '%Pushed:%' THEN r := btrim(l); END IF;
  END LOOP;
  RETURN r;
END $$;
-- The reason line of EXPLAIN (VERBOSE): "Repartition: not used: ...", or "-"
CREATE FUNCTION why(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; r text := '-';
BEGIN
  FOR l IN EXECUTE 'EXPLAIN (COSTS OFF, VERBOSE) ' || q LOOP
    IF l LIKE '%Repartition: not used:%' THEN r := btrim(l); END IF;
  END LOOP;
  RETURN r;
END $$;
SET jit = off;
SET kingres_shard.enable_repartition_join = force;
SET kingres_shard.enable_partial_aggregation = on;
-- ---------------------------------------------------------------------------
-- The role of each table
-- ---------------------------------------------------------------------------
\echo -- o is moved to the groups of cu (the other way round, the same); a filter on each side
-- o is moved to the groups of cu (the other way round, the same); a filter on each side
SELECT * FROM plan_of('SELECT o.id, cu.name FROM o JOIN cu ON cu.id = o.cust');
                                                                                                           plan_of                                                                                                            
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Fragment Scan)
   Pushed: repartitioned join (one table moved by its join key)
   Repartition: o by cust -> placement of colocation 1 (8 buckets)
   Groups: 2 of 2 (local + 1 remote)
   Remote SQL: SELECT o.id, cu.name FROM (( SELECT (u.c1)::integer AS id, (u.c2)::integer AS cust, NULL::text AS amount, NULL::text AS note FROM UNNEST($1, $2) u(c1, c2)) o JOIN public.cu ON ((cu.id = o.cust))) WHERE true
   ->  Custom Scan (Kingres Distributed Scan)
         Remote groups: 1
         Remote SQL: SELECT id, cust FROM public.o AS ks_t
         ->  Append
               ->  Seq Scan on o_b0000 o_1
               ->  Seq Scan on o_b0001 o_2
               ->  Seq Scan on o_b0002 o_3
               ->  Seq Scan on o_b0003 o_4
               ->  Seq Scan on o_b0004 o_5
               ->  Seq Scan on o_b0005 o_6
               ->  Seq Scan on o_b0006 o_7
               ->  Seq Scan on o_b0007 o_8
(17 rows)

SELECT * FROM plan_of('SELECT cu.id, o.id FROM cu JOIN o ON o.cust = cu.id WHERE cu.region = 3 AND o.amount > 5');
                                                                                                                plan_of                                                                                                                
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (Kingres Fragment Scan)
   Pushed: repartitioned join (one table moved by its join key)
   Repartition: o by cust -> placement of colocation 1 (8 buckets)
   Groups: 2 of 2 (local + 1 remote)
   Remote SQL: SELECT cu.id, o.id FROM (public.cu JOIN ( SELECT (u.c1)::integer AS id, (u.c2)::integer AS cust, NULL::text AS amount, NULL::text AS note FROM UNNEST($1, $2) u(c1, c2)) o ON ((o.cust = cu.id))) WHERE (cu.region = 3)
   ->  Custom Scan (Kingres Distributed Scan)
         Filter: (amount > 5)
         Remote groups: 1
         Remote SQL: SELECT id, cust, amount FROM public.o AS ks_t WHERE ((amount > 5))
         ->  Append
               ->  Seq Scan on o_b0000 o_1
                     Filter: (amount > 5)
               ->  Seq Scan on o_b0001 o_2
                     Filter: (amount > 5)
               ->  Seq Scan on o_b0002 o_3
                     Filter: (amount > 5)
               ->  Seq Scan on o_b0003 o_4
                     Filter: (amount > 5)
               ->  Seq Scan on o_b0004 o_5
                     Filter: (amount > 5)
               ->  Seq Scan on o_b0005 o_6
                     Filter: (amount > 5)
               ->  Seq Scan on o_b0006 o_7
                     Filter: (amount > 5)
               ->  Seq Scan on o_b0007 o_8
                     Filter: (amount > 5)
(26 rows)

