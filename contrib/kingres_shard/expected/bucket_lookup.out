         Remote groups: 1
         Remote SQL: SELECT id FROM public.p_int4 AS ks_t WHERE ((id = ANY ('{1,2}'::integer[])))
         ->  Append
               ->  Bitmap Heap Scan on p_int4_b0000 p_int4_1
                     Recheck Cond: (id = ANY ('{1,2}'::integer[]))
                     ->  Bitmap Index Scan on p_int4_b0000_pkey
                           Index Cond: (id = ANY ('{1,2}'::integer[]))
               ->  Bitmap Heap Scan on p_int4_b0002 p_int4_2
                     Recheck Cond: (id = ANY ('{1,2}'::integer[]))
                     ->  Bitmap Index Scan on p_int4_b0002_pkey
                           Index Cond: (id = ANY ('{1,2}'::integer[]))
(14 rows)

