CREATE TABLE res (id int, ord int, bucket int, phys int);
SELECT format('INSERT INTO pt%s SELECT l::%s, o FROM kv, unnest(lits) WITH ORDINALITY u(l, o) WHERE kv.id = %s',
              id, typ, id)
  FROM kv ORDER BY id \gexec
