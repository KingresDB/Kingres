SELECT format('CREATE TABLE pt%s_b%s PARTITION OF pt%s FOR VALUES WITH (MODULUS %s, REMAINDER %s)',
              id, r, id, nb, r)
  FROM kv, generate_series(0, nb - 1) r ORDER BY id, r \gexec
