      'routing_decisions',
      'reference',
      'ddl_single',
      'rebalance_plan',
      'upgrade',
    ],
    'regress_args': ['--temp-config', files('kingres_shard.conf')],
    # The tests need shared_preload_libraries = 'kingres_shard', which a
    # plain "runningcheck" server does not have.
    'runningcheck': false,
