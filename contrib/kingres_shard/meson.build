kingres_shard_sources = files(
  'src/batch_sender.c',
  'src/bucket_move.c',
  'src/catalog.c',
  'src/copy_routed.c',
  'src/dist_scan.c',
  'src/dist_table.c',
  'src/fanout.c',
  'src/failover.c',
  'src/fault.c',
  'src/forward_auth.c',
  'src/fragment_scan.c',

  'src/ha.c',
  'src/hashing.c',
  'src/kingres_shard.c',
  'src/merge.c',
  'src/node_admin.c',
  'src/node_conn.c',
  'src/placement_check.c',
  'src/planner.c',
  'src/prune.c',
