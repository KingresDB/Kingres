kingres_shard_sources = files(
  'src/bucket_move.c',
  'src/catalog.c',
  'src/dist_scan.c',
  'src/dist_table.c',
  'src/fanout.c',
  'src/failover.c',
  'src/fault.c',
  'src/forward_auth.c',
  'src/ha.c',
  'src/hashing.c',
  'src/kingres_shard.c',
  'src/node_admin.c',
  'src/node_conn.c',
  'src/planner.c',
  'src/recovery.c',
  'src/remote_scan.c',
  'src/shippable.c',
  'src/term.c',
  'src/utility.c',
)

if host_system == 'windows'
  kingres_shard_sources += rc_lib_gen.process(win32ver_rc, extra_args: [
    '--NAME', 'kingres_shard',
    '--FILEDESC', 'kingres_shard - KingresDB sharding extension',])
endif

kingres_shard = shared_module('kingres_shard',
  kingres_shard_sources,
  include_directories: include_directories('src'),
  # A call of a function that no header declares must stop the build, not print a
  # warning that nobody reads (a missing prototype once went unnoticed).
  c_args: ['-Werror=implicit-function-declaration'],
  kwargs: contrib_mod_args + {
    'dependencies': contrib_mod_args['dependencies'] + [libpq],
  },
)
contrib_targets += kingres_shard

install_data(
  'kingres_shard.control',
  'kingres_shard--0.1.sql',
  'kingres_shard--0.2.sql',
  'kingres_shard--0.3.sql',
  'kingres_shard--0.4.sql',
  'kingres_shard--0.1--0.2.sql',
  'kingres_shard--0.2--0.3.sql',
  'kingres_shard--0.3--0.4.sql',
  'kingres_shard--0.5.sql',
  'kingres_shard--0.4--0.5.sql',
  kwargs: contrib_data_args,
)

tests += {
  'name': 'kingres_shard',
