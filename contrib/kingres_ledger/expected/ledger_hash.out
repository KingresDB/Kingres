-- The empty tree is SHA-256 of the empty string; one empty leaf is
-- SHA-256(0x00).
SELECT encode(kingres.ledger_merkle_root(x), 'hex') AS empty_root
FROM (SELECT NULL::bytea AS x WHERE false) e;
