(1 row)

-- A different value, a different column name, a different table: different hashes.
INSERT INTO settings_t (id) VALUES (1);
SELECT count(DISTINCT kingres.ledger_row_hash(s)) AS distinct_hashes FROM settings_t s;
 distinct_hashes 
