-- L-05: ledger_enable needs READ COMMITTED
--------------------------------------------------------------------------
CREATE TABLE r_rc (id int);
INSERT INTO r_rc VALUES (1);
BEGIN ISOLATION LEVEL REPEATABLE READ;
SELECT count(*) AS rows_seen FROM r_rc;
 rows_seen 
-----------
         1
(1 row)

SELECT kingres.ledger_enable('r_rc');
ERROR:  ledger_enable requires the READ COMMITTED isolation level
ROLLBACK;
BEGIN ISOLATION LEVEL SERIALIZABLE;
SELECT kingres.ledger_enable('r_rc');
ERROR:  ledger_enable requires the READ COMMITTED isolation level
ROLLBACK;
SELECT count(*) AS r_rc_registered FROM kingres.ledger_table WHERE relid = 'r_rc'::regclass;
 r_rc_registered 
-----------------
               0
(1 row)

BEGIN ISOLATION LEVEL READ COMMITTED;
SELECT kingres.ledger_enable('r_rc');
 ledger_enable 
---------------
 
(1 row)

COMMIT;
SELECT count(*) AS r_rc_registered FROM kingres.ledger_table WHERE relid = 'r_rc'::regclass;
 r_rc_registered 
-----------------
               1
(1 row)

--------------------------------------------------------------------------
-- L-06: extension members are identified by membership, and cannot be
-- renamed, replaced or handed to another owner
--------------------------------------------------------------------------
DO $$
BEGIN
    BEGIN
        ALTER FUNCTION kingres.ledger_capture() RENAME TO ledger_capture_x;
    EXCEPTION WHEN OTHERS THEN
        RAISE NOTICE 'rename rejected: % %', SQLSTATE, SQLERRM;
        RETURN;
    END;
    -- The rename went through: the old hook stops recognising ledger tables.
    BEGIN
        DROP TABLE r_led;
        RAISE NOTICE 'FAIL: DROP TABLE of a ledger table succeeded after the rename';
    EXCEPTION WHEN OTHERS THEN
        RAISE NOTICE 'drop rejected: % %', SQLSTATE, SQLERRM;
    END;
    RAISE EXCEPTION 'undo' USING ERRCODE = 'KL999';
EXCEPTION WHEN SQLSTATE 'KL999' THEN
    NULL;
END $$;
NOTICE:  rename rejected: KL002 cannot rename a function or an event trigger of the ledger
SELECT pg_temp.try(ARRAY[
    'ALTER FUNCTION kingres.ledger_capture() RENAME TO ledger_capture_x',
    'ALTER FUNCTION kingres.ledger_block_modify() RENAME TO other_name',
    'ALTER FUNCTION kingres.ledger_verify(bigint, bigint) RENAME TO ledger_verify_x',
    'ALTER FUNCTION kingres.ledger_capture() OWNER TO kl_owner',
    'ALTER EVENT TRIGGER kingres_ledger_guard_end DISABLE',
    'ALTER EVENT TRIGGER kingres_ledger_guard_end ENABLE REPLICA',
    'ALTER EVENT TRIGGER kingres_ledger_guard_end RENAME TO other_name',
    'ALTER EVENT TRIGGER kingres_ledger_guard_end OWNER TO kl_owner',
    'DROP EVENT TRIGGER kingres_ledger_guard_end',
    'GRANT EXECUTE ON FUNCTION kingres.ledger_capture() TO PUBLIC',
    'GRANT EXECUTE ON FUNCTION kingres.ledger_register_table(regclass) TO kl_other',
    'GRANT INSERT ON kingres.ledger_entry TO kl_other',
    'GRANT ALL ON kingres.ledger_blocks TO kl_other',
    'REVOKE SELECT ON kingres.ledger_blocks FROM CURRENT_USER',
    'REVOKE ALL ON kingres.ledger_entry FROM CURRENT_USER']);
NOTICE:  rejected: ALTER FUNCTION kingres.ledger_capture() RENAME TO ledger_capture_x -> KL002 cannot rename a function or an event trigger of the ledger
NOTICE:  rejected: ALTER FUNCTION kingres.ledger_block_modify() RENAME TO other_name -> KL002 cannot rename a function or an event trigger of the ledger
NOTICE:  rejected: ALTER FUNCTION kingres.ledger_verify(bigint, bigint) RENAME TO ledger_verify_x -> KL002 cannot rename a function or an event trigger of the ledger
NOTICE:  rejected: ALTER FUNCTION kingres.ledger_capture() OWNER TO kl_owner -> KL002 cannot change the owner of a function or an event trigger of the ledger
NOTICE:  rejected: ALTER EVENT TRIGGER kingres_ledger_guard_end DISABLE -> KL002 cannot enable or disable an event trigger of the ledger
NOTICE:  rejected: ALTER EVENT TRIGGER kingres_ledger_guard_end ENABLE REPLICA -> KL002 cannot enable or disable an event trigger of the ledger
NOTICE:  rejected: ALTER EVENT TRIGGER kingres_ledger_guard_end RENAME TO other_name -> KL002 cannot rename a function or an event trigger of the ledger
NOTICE:  rejected: ALTER EVENT TRIGGER kingres_ledger_guard_end OWNER TO kl_owner -> KL002 cannot change the owner of a function or an event trigger of the ledger
NOTICE:  rejected: DROP EVENT TRIGGER kingres_ledger_guard_end -> 2BP01 cannot drop event trigger kingres_ledger_guard_end because extension kingres_ledger requires it
NOTICE:  rejected: GRANT EXECUTE ON FUNCTION kingres.ledger_capture() TO PUBLIC -> KL002 cannot grant or revoke privileges on an internal function of the ledger
NOTICE:  rejected: GRANT EXECUTE ON FUNCTION kingres.ledger_register_table(regclass) TO kl_other -> KL002 cannot grant or revoke privileges on an internal function of the ledger
NOTICE:  rejected: GRANT INSERT ON kingres.ledger_entry TO kl_other -> KL002 cannot grant any privilege other than SELECT on table "ledger_entry": it is part of the ledger
NOTICE:  rejected: GRANT ALL ON kingres.ledger_blocks TO kl_other -> KL002 cannot grant all privileges on table "ledger_blocks": it is part of the ledger
NOTICE:  rejected: REVOKE SELECT ON kingres.ledger_blocks FROM CURRENT_USER -> KL002 cannot revoke privileges of the owner on table "ledger_blocks": it is part of the ledger
NOTICE:  rejected: REVOKE ALL ON kingres.ledger_entry FROM CURRENT_USER -> KL002 cannot revoke privileges of the owner on table "ledger_entry": it is part of the ledger
