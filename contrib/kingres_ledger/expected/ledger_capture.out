-- Now that blocks, transactions and entries exist, every statement that
-- would modify them is rejected, for every role.
DO $$
DECLARE
    stmt text;
BEGIN
    FOREACH stmt IN ARRAY ARRAY[
        'UPDATE kingres.ledger_blocks SET height = height',
        'DELETE FROM kingres.ledger_blocks',
        'TRUNCATE kingres.ledger_blocks',
        'UPDATE kingres.ledger_tx SET tx_index = tx_index',
        'DELETE FROM kingres.ledger_tx',
        'UPDATE kingres.ledger_entry SET seq = seq',
        'DELETE FROM kingres.ledger_table',
        'TRUNCATE kingres.ledger_table, kingres.ledger_entry']
    LOOP
        BEGIN
            EXECUTE stmt;
            RAISE NOTICE '% -> no error', stmt;
        EXCEPTION WHEN OTHERS THEN
            RAISE NOTICE '% -> % %', stmt, SQLSTATE, SQLERRM;
        END;
    END LOOP;
END $$;
NOTICE:  UPDATE kingres.ledger_blocks SET height = height -> KL001 table "ledger_blocks" is an append-only ledger table
NOTICE:  DELETE FROM kingres.ledger_blocks -> KL001 table "ledger_blocks" is an append-only ledger table
NOTICE:  TRUNCATE kingres.ledger_blocks -> KL001 table "ledger_blocks" is an append-only ledger table
NOTICE:  UPDATE kingres.ledger_tx SET tx_index = tx_index -> KL001 table "ledger_tx" is an append-only ledger table
NOTICE:  DELETE FROM kingres.ledger_tx -> KL001 table "ledger_tx" is an append-only ledger table
NOTICE:  UPDATE kingres.ledger_entry SET seq = seq -> KL001 table "ledger_entry" is an append-only ledger table
NOTICE:  DELETE FROM kingres.ledger_table -> KL001 table "ledger_table" is an append-only ledger table
NOTICE:  TRUNCATE kingres.ledger_table, kingres.ledger_entry -> KL001 table "ledger_table" is an append-only ledger table
