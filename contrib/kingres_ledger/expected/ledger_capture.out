       prev_hash = kingres.ledger_genesis_hash((SELECT chain_id FROM kingres.ledger_chain))
           AS prev_is_derived_from_chain_id,
       prev_hash = decode(repeat('00', 32), 'hex') AS prev_is_zero,
       hash_version
FROM kingres.ledger_blocks;
