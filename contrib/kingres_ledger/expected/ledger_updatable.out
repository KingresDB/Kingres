UPDATE inv SET qty = 21 WHERE id = 2;
UPDATE inv SET qty = 22, note = 'm' WHERE id = 2;
DELETE FROM inv WHERE id = 2;
INSERT INTO inv VALUES (2, 'nut', 23, 'again');
COMMIT;
