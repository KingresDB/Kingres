 ledger_build_block      |                                                                                                                                                                                                                                               | f
 ledger_capture          |                                                                                                                                                                                                                                               | f
 ledger_catalog_defects  |                                                                                                                                                                                                                                               | t
 ledger_enable           | relation regclass, mode text                                                                                                                                                                                                                  | f
 ledger_generate_digest  |                                                                                                                                                                                                                                               | f
 ledger_genesis_hash     | chain_id bytea                                                                                                                                                                                                                                | t
 ledger_guard            |                                                                                                                                                                                                                                               | t
 ledger_history_acl_sync | relation regclass, history regclass                                                                                                                                                                                                           | f
 ledger_history_defects  | p_hist oid, p_relid oid                                                                                                                                                                                                                       | t
 ledger_history_row_hash | record                                                                                                                                                                                                                                        | t
 ledger_history_sync     | relation regclass, history regclass                                                                                                                                                                                                           | f
 ledger_hook_active      |                                                                                                                                                                                                                                               | t
 ledger_inclusion_proof  | relation regclass, row_hash bytea                                                                                                                                                                                                             | f
 ledger_inclusion_proof  | relation regclass, row_hash bytea, op "char"                                                                                                                                                                                                  | f
 ledger_is_member        | p_classid oid, p_objid oid                                                                                                                                                                                                                    | t
 ledger_leaf_hash        | data bytea                                                                                                                                                                                                                                    | t
 ledger_lock_table       | relation regclass                                                                                                                                                                                                                             | f
 ledger_merkle_accum     | internal, bytea                                                                                                                                                                                                                               | t
 ledger_merkle_final     | internal                                                                                                                                                                                                                                      | t
 ledger_merkle_path      | leaf_hashes bytea[], leaf_index integer                                                                                                                                                                                                       | t
