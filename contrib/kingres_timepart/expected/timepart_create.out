 de_p20260328 | FROM ('2026-03-27 23:00:00+00') TO ('2026-03-28 23:00:00+00')
 de_p20260329 | FROM ('2026-03-28 23:00:00+00') TO ('2026-03-29 22:00:00+00')
 de_p20260330 | FROM ('2026-03-29 22:00:00+00') TO ('2026-03-30 22:00:00+00')
(4 rows)

SELECT * FROM tp.gaps('tp.de');
 gap_from | gap_to 
----------+--------
(0 rows)

