-- A relation that already has the name of a partition to create: the call
-- fails, and nothing of it remains (one transaction).
CREATE TABLE tp.clash (ts timestamptz NOT NULL) PARTITION BY RANGE (ts);
CREATE TABLE tp.clash_p20260303 (x int);
SELECT kingres.create_time_partitions('tp.clash', '1 day', '2026-03-05 UTC', '2026-03-01 UTC');
ERROR:  name_conflict: relation tp.clash_p20260303 already exists and is not the expected partition of tp.clash
SELECT count(*) AS partitions FROM tp.parts('tp.clash');
 partitions 
------------
          0
(1 row)

SELECT to_regclass('tp.clash_p20260301') IS NULL AS first_one_rolled_back;
 first_one_rolled_back 
-----------------------
 t
(1 row)

-- A default partition: refused up front, with the reason.
CREATE TABLE tp.withdef (ts timestamptz NOT NULL) PARTITION BY RANGE (ts);
CREATE TABLE tp.withdef_default PARTITION OF tp.withdef DEFAULT;
SELECT kingres.create_time_partitions('tp.withdef', '1 day', '2026-03-05 UTC', '2026-03-01 UTC');
ERROR:  table tp.withdef has a default partition "withdef_default"
HINT:  ATTACH PARTITION scans the default partition under a strong lock; create partitions far enough ahead instead.
-- Tables that are not suitable.
CREATE TABLE tp.plain (ts timestamptz);
SELECT kingres.create_time_partitions('tp.plain', '1 day', '2026-03-05 UTC', '2026-03-01 UTC');
ERROR:  tp.plain is not a partitioned table
CREATE TABLE tp.lst (ts timestamptz NOT NULL) PARTITION BY LIST (ts);
SELECT kingres.create_time_partitions('tp.lst', '1 day', '2026-03-05 UTC', '2026-03-01 UTC');
ERROR:  tp.lst is not partitioned by RANGE
CREATE TABLE tp.hsh (id int) PARTITION BY HASH (id);
SELECT kingres.create_time_partitions('tp.hsh', '1 day', '2026-03-05 UTC', '2026-03-01 UTC');
ERROR:  tp.hsh is not partitioned by RANGE
CREATE TABLE tp.expr (ts timestamptz NOT NULL) PARTITION BY RANGE ((ts AT TIME ZONE 'UTC'));
SELECT kingres.create_time_partitions('tp.expr', '1 day', '2026-03-05 UTC', '2026-03-01 UTC');
ERROR:  tp.expr must be partitioned by exactly one column, which is not an expression
CREATE TABLE tp.multi (ts timestamptz NOT NULL, k int NOT NULL) PARTITION BY RANGE (ts, k);
SELECT kingres.create_time_partitions('tp.multi', '1 day', '2026-03-05 UTC', '2026-03-01 UTC');
ERROR:  tp.multi must be partitioned by exactly one column, which is not an expression
CREATE TABLE tp.badtype (n int NOT NULL) PARTITION BY RANGE (n);
SELECT kingres.create_time_partitions('tp.badtype', '1 day', '2026-03-05 UTC', '2026-03-01 UTC');
ERROR:  partition column "n" of tp.badtype must be of type date, timestamp or timestamptz
CREATE TEMP TABLE tmp_t (ts timestamptz NOT NULL) PARTITION BY RANGE (ts);
SELECT kingres.create_time_partitions('tmp_t', '1 day', '2026-03-05 UTC', '2026-03-01 UTC');
ERROR:  temporary table "tmp_t" is not supported
-- Bad arguments.
SELECT kingres.create_time_partitions('tp.am', '5 hours', '2026-03-05 UTC', '2026-03-01 UTC');
ERROR:  invalid partition_every "05:00:00"
HINT:  Hours must divide a day: 1, 2, 3, 4, 6, 8, 12 or 24.
SELECT kingres.create_time_partitions('tp.am', '1 day', '2026-03-01 UTC', '2026-03-05 UTC');
ERROR:  end_at is before start_from
SELECT kingres.create_time_partitions('tp.am', '1 day', 'infinity', '2026-03-05 UTC');
ERROR:  start_from and end_at must be finite times
SELECT kingres.create_time_partitions('tp.am', '1 day', '2026-03-05 UTC', '2026-03-01 UTC', NULL, 'Nowhere/Land');
ERROR:  unknown time zone "Nowhere/Land"
HINT:  Use a name from pg_timezone_names, for example UTC or Europe/Berlin.
-- Too many partitions in one call.
CREATE TABLE tp.many (ts timestamptz NOT NULL) PARTITION BY RANGE (ts);
SELECT kingres.create_time_partitions('tp.many', '1 hour', '2030-01-01 UTC', '2026-01-01 UTC');
ERROR:  too many partitions in one call: 35065 cells
HINT:  Create at most 10000 partitions per call; use a wider partition_every or a shorter range.
SELECT count(*) AS partitions FROM tp.parts('tp.many');
 partitions 
------------
          0
(1 row)

-- Zones that skipped a whole calendar day (Apia 2011-12-30, Kwajalein
-- 1993-08-21, Kiritimati 1994-12-31, Fakaofo 2011-12-30): the cell of that day
-- would start and end at one instant.  It is left out: no empty partition, no
-- duplicate name, and the cells on both sides still meet.
SELECT tz, count(*) AS cells, count(*) FILTER (WHERE e = s) AS empty_cells,
       bool_and(e = s OR kingres.timepart_cell_of('1 day', tz, s) = k) AS start_in_cell,
       bool_and(e = s OR kingres.timepart_cell_of('1 day', tz, e - interval '1 microsecond') = k) AS end_in_cell
  FROM (SELECT tz, k, kingres.timepart_cell_start('1 day', tz, k) AS s,
               kingres.timepart_cell_start('1 day', tz, k + 1) AS e
          FROM (VALUES ('Pacific/Apia', timestamptz '2011-12-28 12:00 UTC'),
                       ('Pacific/Fakaofo', timestamptz '2011-12-28 12:00 UTC'),
                       ('Pacific/Kwajalein', timestamptz '1993-08-19 12:00 UTC'),
                       ('Pacific/Kiritimati', timestamptz '1994-12-29 12:00 UTC')) z(tz, t),
               LATERAL generate_series(kingres.timepart_cell_of('1 day', tz, t),
                                       kingres.timepart_cell_of('1 day', tz, t) + 4) k) c
 GROUP BY tz ORDER BY tz;
         tz         | cells | empty_cells | start_in_cell | end_in_cell 
--------------------+-------+-------------+---------------+-------------
 Pacific/Apia       |     5 |           1 | t             | t
 Pacific/Fakaofo    |     5 |           1 | t             | t
 Pacific/Kiritimati |     5 |           1 | t             | t
 Pacific/Kwajalein  |     5 |           1 | t             | t
(4 rows)

CREATE TABLE tp.apia (ts timestamptz NOT NULL, v int) PARTITION BY RANGE (ts);
SELECT kingres.create_time_partitions('tp.apia', '1 day', '2012-01-02 UTC', '2011-12-28 UTC', NULL, 'Pacific/Apia');
