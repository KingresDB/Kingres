 t2_p20260304 | FROM ('2026-03-04 00:00:00+00') TO ('2026-03-05 00:00:00+00')
 t2_p20260305 | FROM ('2026-03-05 00:00:00+00') TO ('2026-03-06 00:00:00+00')
 t2_p20260306 | FROM ('2026-03-06 00:00:00+00') TO ('2026-03-07 00:00:00+00')
(4 rows)

SELECT c.relname, c.relispartition, (SELECT count(*) FROM tp.t2_p20260301) AS rows_in_first
  FROM pg_class c WHERE c.oid = 'tp.t2_p20260301'::regclass;
   relname    | relispartition | rows_in_first 
--------------+----------------+---------------
