(1 row)

DROP SCHEMA tpc CASCADE;
NOTICE:  drop cascades to 12 other objects
DETAIL:  drop cascades to table tpc.log
drop cascades to table tpc.arm
drop cascades to table tpc.dtab
drop cascades to function tpc.leak(text)
drop cascades to function tpc.dtrig()
drop cascades to function tpc.leave()
drop cascades to function tpc.f_leave(integer)
drop cascades to function tpc.f_spy(integer)
drop cascades to table tpc.t1
drop cascades to table tpc.t2
drop cascades to table tpc.t4
drop cascades to table tpc.t3
DELETE FROM kingres.timepart_run_data WHERE schema_name = 'tpc';
DROP OWNED BY tp_c_owner, tp_c_super;
DROP ROLE tp_c_owner, tp_c_super;
