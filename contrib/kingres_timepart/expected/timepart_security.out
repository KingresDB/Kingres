SELECT table_owner, created_by FROM kingres.timepart_policy WHERE schema_name = 'tpo';
 table_owner | created_by 
-------------+------------
 tp_other    | tp_owner
(1 row)

\o /dev/null
CALL kingres.timepart_run('tpo.o1', '2026-03-12 UTC');
\o
SELECT * FROM tp.last_run('tpo', 'o1');
  state  | trigger | error 
---------+---------+-------
 partial | sql     | 
