-- The partitions made earlier still belong to the old owner, and the new owner
-- cannot drop them: PostgreSQL does not move them with the table.
SELECT kind, partition_name, state, detail FROM tp.last_actions('tpo', 'o1') ORDER BY kind, partition_name;
  kind  | partition_name | state  |                   detail                   
--------+----------------+--------+--------------------------------------------
 create | o1_p20260309   | done   | 
 create | o1_p20260310   | done   | 
 create | o1_p20260311   | done   | 
 create | o1_p20260312   | done   | 
 create | o1_p20260313   | done   | 
 drop   | o1_p20260302   | failed | 42501: must be owner of table o1_p20260302
 drop   | o1_p20260303   | failed | 42501: must be owner of table o1_p20260303
 drop   | o1_p20260304   | failed | 42501: must be owner of table o1_p20260304
 drop   | o1_p20260305   | failed | 42501: must be owner of table o1_p20260305
 drop   | o1_p20260306   | failed | 42501: must be owner of table o1_p20260306
(10 rows)

