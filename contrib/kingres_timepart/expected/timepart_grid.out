-- timepart_grid: the grid of partition bounds: accepted and refused
-- intervals, cells across daylight-saving changes, leap years, month ends,
-- weeks, and the generated names.
--
-- Portions Copyright (c) 2026, RooyeKhat Media Co
-- SPDX-License-Identifier: PostgreSQL
SET timezone = 'UTC';
SET datestyle = ISO;
SET intervalstyle = postgres;
\set VERBOSITY default
\set SHOW_CONTEXT never
-- Accepted shapes: unit and count.
SELECT every, p.unit, p.n
  FROM unnest(ARRAY['1 hour', '2 hours', '3 hours', '4 hours', '6 hours', '8 hours',
                    '12 hours', '24 hours', '1 day', '3 days', '10 days', '7 days',
                    '1 week', '1 month', '2 months', '3 months', '4 months',
                    '6 months', '12 months', '1 year', '5 years']::interval[]) AS every,
       LATERAL kingres.timepart_interval_parts(every) p;
  every   | unit  | n  
----------+-------+----
 01:00:00 | hour  |  1
 02:00:00 | hour  |  2
 03:00:00 | hour  |  3
 04:00:00 | hour  |  4
 06:00:00 | hour  |  6
 08:00:00 | hour  |  8
 12:00:00 | hour  | 12
 24:00:00 | hour  | 24
 1 day    | day   |  1
 3 days   | day   |  3
 10 days  | day   | 10
 7 days   | week  |  1
 7 days   | week  |  1
 1 mon    | month |  1
 2 mons   | month |  2
 3 mons   | month |  3
 4 mons   | month |  4
 6 mons   | month |  6
 1 year   | year  |  1
 1 year   | year  |  1
 5 years  | year  |  5
(21 rows)

-- Refused shapes.
SELECT kingres.timepart_interval_parts('5 hours');
ERROR:  invalid partition_every "05:00:00"
HINT:  Hours must divide a day: 1, 2, 3, 4, 6, 8, 12 or 24.
SELECT kingres.timepart_interval_parts('90 minutes');
ERROR:  invalid partition_every "01:30:00"
HINT:  Hours must divide a day: 1, 2, 3, 4, 6, 8, 12 or 24.
SELECT kingres.timepart_interval_parts('1 day 1 hour');
ERROR:  invalid partition_every "1 day 01:00:00"
HINT:  Use N hours (24 mod N = 0), N days, 1 week, N months (12 mod N = 0) or N years, in one unit.
SELECT kingres.timepart_interval_parts('1 month 1 day');
ERROR:  invalid partition_every "1 mon 1 day"
HINT:  Use N hours (24 mod N = 0), N days, 1 week, N months (12 mod N = 0) or N years, in one unit.
SELECT kingres.timepart_interval_parts('5 months');
ERROR:  invalid partition_every "5 mons"
HINT:  Months must divide a year: 1, 2, 3, 4, 6 or 12.
SELECT kingres.timepart_interval_parts('18 months');
ERROR:  invalid partition_every "1 year 6 mons"
HINT:  Months must divide a year: 1, 2, 3, 4, 6 or 12.
SELECT kingres.timepart_interval_parts('0 days');
ERROR:  invalid partition_every "00:00:00"
HINT:  Use N hours (24 mod N = 0), N days, 1 week, N months (12 mod N = 0) or N years, in one unit.
SELECT kingres.timepart_interval_parts('-1 day');
ERROR:  invalid partition_every "-1 days"
HINT:  Use N hours (24 mod N = 0), N days, 1 week, N months (12 mod N = 0) or N years, in one unit.
SELECT kingres.timepart_interval_parts('10000 days');
ERROR:  invalid partition_every "10000 days"
HINT:  At most 3660 days.
SELECT kingres.timepart_interval_parts(NULL);
ERROR:  partition_every must not be null
SELECT kingres.timepart__check_tz('Mars/Olympus');
ERROR:  unknown time zone "Mars/Olympus"
HINT:  Use a name from pg_timezone_names, for example UTC or Europe/Berlin.
SELECT kingres.timepart__check_tz('+02');
ERROR:  unknown time zone "+02"
HINT:  Use a name from pg_timezone_names, for example UTC or Europe/Berlin.
-- Cells never overlap and never leave a gap, and every instant is in the
-- cell cell_of says: for each shape and zone, over two years that contain
-- daylight-saving changes, cell_of(start(k)) = k, cell_of(start(k+1) - 1 us)
-- = k, and the cells are strictly increasing.  Zones: none, whole hour,
-- half hour (Lord Howe), a change at midnight (Havana), a half-hour offset
-- without change (Kolkata).
WITH shapes(every) AS (
    VALUES ('1 hour'::interval), ('6 hours'), ('1 day'), ('3 days'), ('1 week'),
           ('1 month'), ('3 months'), ('1 year')),
zones(tz) AS (
    VALUES ('UTC'), ('Europe/Berlin'), ('America/New_York'),
           ('Australia/Lord_Howe'), ('America/Havana'), ('Asia/Kolkata')),
base AS (
    SELECT every, tz,
           kingres.timepart_cell_of(every, tz, timestamptz '2025-01-01 00:00 UTC') AS k0,
           kingres.timepart_cell_of(every, tz, timestamptz '2026-12-31 00:00 UTC') AS k1
      FROM shapes, zones),
ks AS (
    SELECT every, tz, k
      FROM base, LATERAL generate_series(k0, least(k1, k0 + 400)) k)
SELECT every, tz, count(*) AS cells,
       bool_and(kingres.timepart_cell_of(every, tz, kingres.timepart_cell_start(every, tz, k)) = k) AS start_in_cell,
       bool_and(kingres.timepart_cell_of(every, tz, kingres.timepart_cell_start(every, tz, k + 1) - interval '1 microsecond') = k) AS end_in_cell,
       bool_and(kingres.timepart_cell_start(every, tz, k + 1) > kingres.timepart_cell_start(every, tz, k)) AS increasing
  FROM ks
 GROUP BY every, tz
 ORDER BY every, tz;
  every   |         tz          | cells | start_in_cell | end_in_cell | increasing 
----------+---------------------+-------+---------------+-------------+------------
 01:00:00 | America/Havana      |   401 | t             | t           | t
 01:00:00 | America/New_York    |   401 | t             | t           | t
 01:00:00 | Asia/Kolkata        |   401 | t             | t           | t
 01:00:00 | Australia/Lord_Howe |   401 | t             | t           | t
 01:00:00 | Europe/Berlin       |   401 | t             | t           | t
 01:00:00 | UTC                 |   401 | t             | t           | t
 06:00:00 | America/Havana      |   401 | t             | t           | t
 06:00:00 | America/New_York    |   401 | t             | t           | t
 06:00:00 | Asia/Kolkata        |   401 | t             | t           | t
 06:00:00 | Australia/Lord_Howe |   401 | t             | t           | t
 06:00:00 | Europe/Berlin       |   401 | t             | t           | t
 06:00:00 | UTC                 |   401 | t             | t           | t
 1 day    | America/Havana      |   401 | t             | t           | t
 1 day    | America/New_York    |   401 | t             | t           | t
 1 day    | Asia/Kolkata        |   401 | t             | t           | t
 1 day    | Australia/Lord_Howe |   401 | t             | t           | t
 1 day    | Europe/Berlin       |   401 | t             | t           | t
 1 day    | UTC                 |   401 | t             | t           | t
 3 days   | America/Havana      |   244 | t             | t           | t
 3 days   | America/New_York    |   244 | t             | t           | t
 3 days   | Asia/Kolkata        |   244 | t             | t           | t
 3 days   | Australia/Lord_Howe |   244 | t             | t           | t
 3 days   | Europe/Berlin       |   244 | t             | t           | t
 3 days   | UTC                 |   244 | t             | t           | t
 7 days   | America/Havana      |   105 | t             | t           | t
 7 days   | America/New_York    |   105 | t             | t           | t
 7 days   | Asia/Kolkata        |   105 | t             | t           | t
 7 days   | Australia/Lord_Howe |   105 | t             | t           | t
 7 days   | Europe/Berlin       |   105 | t             | t           | t
 7 days   | UTC                 |   105 | t             | t           | t
 1 mon    | America/Havana      |    25 | t             | t           | t
 1 mon    | America/New_York    |    25 | t             | t           | t
 1 mon    | Asia/Kolkata        |    24 | t             | t           | t
 1 mon    | Australia/Lord_Howe |    24 | t             | t           | t
 1 mon    | Europe/Berlin       |    24 | t             | t           | t
 1 mon    | UTC                 |    24 | t             | t           | t
 3 mons   | America/Havana      |     9 | t             | t           | t
 3 mons   | America/New_York    |     9 | t             | t           | t
 3 mons   | Asia/Kolkata        |     8 | t             | t           | t
 3 mons   | Australia/Lord_Howe |     8 | t             | t           | t
 3 mons   | Europe/Berlin       |     8 | t             | t           | t
 3 mons   | UTC                 |     8 | t             | t           | t
 1 year   | America/Havana      |     3 | t             | t           | t
 1 year   | America/New_York    |     3 | t             | t           | t
 1 year   | Asia/Kolkata        |     2 | t             | t           | t
