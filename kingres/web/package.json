{
  "name": "kingres-web",
  "version": "0.1.0",
  "author": "Mohammad Rasoul Kazemi (RooyeKhat)",
  "private": true,
  "type": "module",
  "license": "PostgreSQL",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:backend": "vite --mode backend",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:generate": "node scripts/gen-api.mjs",
    "api:check": "node scripts/gen-api.mjs --check",
    "brand:sync": "node scripts/brand-sync.mjs",
    "brand:check": "node scripts/brand-sync.mjs --check",
    "e2e": "node scripts/e2e/run.mjs",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.107.1",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.10",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.17.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14",
    "yaml": "^2.9.1"
  }
}
