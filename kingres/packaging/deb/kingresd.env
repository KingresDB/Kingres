#
# Environment of the kingres.service unit.  Readable by root only (mode 0600):
# put secrets here, not in kingresd.json.  Lines are KEY=value without quotes
# or "export".  Environment settings override kingresd.json; command-line
# flags (none in the unit) would override both.  The settings are documented in
# /usr/share/doc/kingres/README.Debian and by "kingresd -h".
#
# Bearer token that may scrape /metrics (Prometheus):
#KINGRES_METRICS_TOKEN=CHANGE-ME-long-random-value
#
# To reach the panel from other machines, listen on a routable address and
# enable TLS (certificate and key must be readable by the kingres user):
#KINGRES_LISTEN=0.0.0.0:8091
#KINGRES_TLS_CERT_FILE=/etc/kingres/panel.crt
#KINGRES_TLS_KEY_FILE=/etc/kingres/panel.key
# While the node is uninitialized, setup calls from other machines are refused
# unless this is true (the setup token is still required):
#KINGRES_ALLOW_REMOTE_SETUP=false
