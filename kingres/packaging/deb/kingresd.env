#
# Environment of the kingres.service unit.  Readable by root only (mode 0600):
# put secrets here, not in kingresd.json.  Lines are KEY=value without quotes
# or "export".  Settings given here override kingresd.json; the complete list
# of settings is in /usr/share/doc/kingres/README.Debian and in the kingresd
# documentation.
#
# DSN of the local PostgreSQL instance that holds the cluster catalog
# (needed once the node is initialized and a service role exists):
#KINGRES_PG_DSN=host=127.0.0.1 port=5432 dbname=postgres user=kingresd password=CHANGE-ME
#
# To reach the panel from other machines, listen on a routable address
# (and enable TLS with KINGRES_TLS_CERT_FILE and KINGRES_TLS_KEY_FILE):
#KINGRES_LISTEN=0.0.0.0:8091
