#
# The one KingresDB service of a node.  kingresd serves the panel and the REST
# API and manages the local PostgreSQL instance: it runs initdb, starts the
# instance with pg_ctl and re-adopts it when kingresd itself restarts.  The
# instance is an independent process (not a child that dies with kingresd), so
# two kinds of restart exist:
#
#   restart the manager only (the database keeps running):
#       systemctl kill --kill-whom=main --signal=SIGTERM kingres
#     kingresd exits cleanly, Restart=always starts it again, and it adopts the
#     running instance.  ExecStop is not run, because the unit is not stopped.
#
#   restart everything (the database restarts too):
#       systemctl restart kingres
#     ExecStop stops the instance with a fast shutdown, then the unit starts.
#
# Settings: /etc/kingres/kingresd.json and /etc/kingres/kingresd.env.
# Data: /var/lib/kingres.  Sockets: /run/kingres.

[Unit]
Description=KingresDB node (management panel, REST API and instance manager)
Documentation=file:///usr/share/doc/kingres/README.Debian
After=network-online.target
Wants=network-online.target

[Service]
# kingresd sends READY=1 once its API listens and STOPPING=1 when it stops.
Type=notify
NotifyAccess=main
User=kingres
Group=kingres
UMask=0027
# Secrets (for example KINGRES_METRICS_TOKEN) go in the env file, which is
# root-only and read by systemd before privileges are dropped.
EnvironmentFile=-/etc/kingres/kingresd.env
Environment=PATH=/opt/kingres/bin:/usr/bin:/bin
ExecStart=/opt/kingres/bin/kingresd -config /etc/kingres/kingresd.json
ExecStop=/opt/kingres/bin/kingresd -config /etc/kingres/kingresd.json -stop-instances
# ExecStop runs while kingresd still runs, so the group lease is renewed during the
# fast shutdown and the lease watchdog has nothing to decide; the stop also tells the
# watchdog to stand down once the shutdown was requested.  It must not become
# ExecStopPost: that runs after every exit of kingresd, also the one before the
# restart of the manager alone, which must leave the database running.
# Only the main process is signalled: the database must not be killed with the
# manager.  ExecStop has already stopped it when the unit is stopped for real.
KillMode=process
Restart=always
RestartSec=3s
# A fast shutdown of PostgreSQL checkpoints first; after this the unit gives up
# and crash recovery repairs the instance at the next start.
TimeoutStopSec=120s
LimitNOFILE=65536
# PostgreSQL creates one process per connection and workers: a generous but
# finite bound.
TasksMax=16384
# Under memory pressure prefer to kill other services before the database
# (a moderate value: the unit is not exempt, and backends inherit it).
OOMScoreAdjust=-100

# Directories.  /run/kingres holds one directory per instance with its Unix
# socket (kingresd creates /run/kingres/<id> before it starts an instance) and
# survives a restart of the unit (the instance keeps running);
# /var/lib/kingres (created by the package) is the only other place the
# service may write.
RuntimeDirectory=kingres
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
ReadWritePaths=/var/lib/kingres

# Sandboxing.  Chosen so that PostgreSQL (initdb, pg_ctl, postgres and its
# workers) still works: no MemoryDenyWriteExecute (extensions map executable
# memory), no PrivateNetwork (clients connect over TCP), no ProtectProc, no
# PrivateIPC (System V shared memory of the postmaster must stay visible), and
# a system call filter of the generic "system-service" set.  PrivateTmp is safe
# because sockets live in /run/kingres, never in /tmp.  PrivateDevices still
# provides /dev/shm for PostgreSQL's dynamic shared memory.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
